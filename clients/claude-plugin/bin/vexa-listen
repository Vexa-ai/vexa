#!/bin/sh
# vexa-listen — follow one live call in the background and exit on the first thing for Claude.
#
#   VEXA_LISTEN_KEY=<key> sh vexa-listen <api_url> <platform> <native_meeting_id> [since_index]
#
# The key comes from the Vexa tool `listen_token` (transcripts only, a few hours). Each read is
# Vexa's `wait_for_signal` (≤25 s); every read also tells Vexa this call is being listened to, which
# is what the call panel shows. Output, then exit:
#   addressed <next_index>   then the lines that named Claude, one per line   (exit 0)
#   ended <next_index>                                                         (exit 0)
#   expired                  the key no longer works: get a new one           (exit 2)
#   unreachable              Vexa did not answer for a while                   (exit 3)
set -u
api=${1:?api_url}; platform=${2:?platform}; native=${3:?native_meeting_id}; since=${4:-0}
key=${VEXA_LISTEN_KEY:?VEXA_LISTEN_KEY}
fails=0
while :; do
  body=$(curl -sS --max-time 40 -w '\n%{http_code}' -H "X-API-Key: $key" \
    "$api/transcripts/$platform/$native/signal?since_index=$since&timeout_sec=25&listener=1&format=text" 2>/dev/null)
  code=$(printf '%s\n' "$body" | tail -n 1)
  text=$(printf '%s\n' "$body" | sed '$d')
  case "$code" in
    200) fails=0 ;;
    401|403) echo expired; exit 2 ;;
    *) fails=$((fails + 1)); [ "$fails" -ge 10 ] && { echo unreachable; exit 3; }; sleep 5; continue ;;
  esac
  set -- $(printf '%s\n' "$text" | head -n 1)
  signal=${1:-quiet}; next=${2:-$since}
  case "$signal" in
    addressed) printf '%s\n' "$text"; exit 0 ;;
    ended) echo "ended $next"; exit 0 ;;
    *) since=$next ;;
  esac
done
