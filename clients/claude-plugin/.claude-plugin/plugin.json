{
  "name": "vexa",
  "displayName": "Vexa",
  "version": "0.2.17-rc",
  "description": "Send a bot to a Google Meet, Teams or Zoom call and follow the live transcript beside the chat. Nothing to configure: Claude offers to sign you in and gives you the link.",
  "author": {
    "name": "Vexa",
    "url": "https://github.com/Vexa-ai"
  },
  "homepage": "https://docs.vexa.ai/vexa-mcp",
  "repository": "https://github.com/Vexa-ai/vexa",
  "license": "Apache-2.0",
  "icon": ".claude-plugin/icon.png",
  "privacyPolicyUrl": "https://vexa.ai/legal/privacy",
  "keywords": [
    "meetings",
    "transcription",
    "google-meet",
    "microsoft-teams",
    "zoom",
    "meeting-bot",
    "mcp"
  ],
  "types": "./types/index.d.ts",
  "mcpServers": {
    "vexa": {
      "type": "http",
      "url": "https://claude-rc.dev.vexa.ai/mcp",
      "headers": {
        "X-API-Key": "${VEXA_API_KEY:-}"
      }
    }
  }
}
