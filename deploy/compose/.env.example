# =============================================================================
# Vexa open-core — compose environment. Copy to .env:  cp .env.example .env
# `make all` copies this automatically on first run if .env is absent.
# Infra defaults below are dev-safe; fill the CREDENTIALS block for full function.
# =============================================================================

# --- project + host ports ----------------------------------------------------
# NOTE: keep comments on their OWN line, never trailing a value. This file is consumed by
# `docker run --env-file` (deploy/lite), whose parser does NOT strip an inline comment — it becomes
# part of the value. A trailing comment here once made Lite's `docker run` word-split a bare `#`
# into the image slot ("docker: invalid reference format"), and shipped commented-out ports as
# literal values.
COMPOSE_PROJECT_NAME=vexa-v012
# API gateway (all docs/SDK calls target this)
API_GATEWAY_HOST_PORT=18056
# admin-api (mint API keys)
ADMIN_API_PORT=18057
MEETING_API_PORT=18080
RUNTIME_API_PORT=18090
AGENT_API_PORT=18100
# the terminal workbench UI → http://localhost:13000
TERMINAL_PORT=13000
POSTGRES_HOST_PORT=5458
# the storage service's S3 port, loopback only (make login uploads a bot session through it)
STORAGE_HOST_PORT=18900

# --- images ------------------------------------------------------------------
IMAGE_TAG=v012

# The build stamp agent-api reports on GET /api/version and the terminal's reload bar compares
# against (PRD decision 39). Empty -> falls back to IMAGE_TAG, which is what a plain `up -d`
# should say. The blue/green deploy sets it per swap.
VEXA_BUILD_SHA=
# v012 tags are the published 0.12-line images. Do NOT fall back to `dev`: the published
# vexaai/vexa-bot:dev on Docker Hub is the older 0.10 line and is INCOMPATIBLE with this stack's
# lifecycle.v1 contract (bots reach `joining` then fail). For a source dev loop, build the bot
# locally with `make -C deploy/compose bot` and point BROWSER_IMAGE at your local tag.
BROWSER_IMAGE=vexaai/vexa-bot:${IMAGE_TAG}
DOCKER_GID=0
LOG_LEVEL=info

# --- redis (valkey) -----------------------------------------------------------
# The default user's password: the services connect with it, and no bot or worker ever sees it
# (each connects as a Redis user of its own). No default — redis refuses to start without one.
# `make up` mints it here; by hand (hex keeps it URL-safe):  openssl rand -hex 32
REDIS_PASSWORD=

# --- database ----------------------------------------------------------------
DB_NAME=vexa
DB_USER=postgres
# No default: postgres refuses to start on an empty or published value. `make up` mints one here;
# by hand:  openssl rand -hex 32. Changing it on an existing database means ALTER USER first.
DB_PASSWORD=

# --- object storage (the `storage` service: versitygw) -----------------------
# meeting-api keeps the MINIO_* names. ACCESS/SECRET are the storage server's root credentials and
# have no default: the storage service refuses to start on an empty or published pair. `make up` mints
# one here (and replaces a published one); by hand: openssl rand -hex 32. MINIO_ENDPOINT (host:port) is
# where meeting-api stores recordings: storage:9000 is the in-stack service; set your own S3's
# host:port and keys to use that instead.
# Upgrading an install that ran MinIO: https://docs.vexa.ai/upgrade-from-minio
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=vexa
MINIO_ENDPOINT=storage:9000
MINIO_SECURE=false

# --- stack secrets (CHANGE for any non-local deploy) -------------------------
# admin-api auth; `make all` mints your API key with this. THE SAME VALUE reaches meeting-api as
# ADMIN_TOKEN, which derives the per-spawn MeetingToken signing key from it, and flows as
# VEXA_FLOWS_ADMIN_KEY. It MINTS AN API KEY FOR ANY USER, so it is the largest single secret in the
# stack. No default: meeting-api and flows refuse to boot without one, and they and admin-api refuse
# any value this repository ever published for it (it shipped here as `dev-admin-token`). `make up`
# mints one here and replaces a published one; by hand:  openssl rand -hex 32
ADMIN_TOKEN=
# The INTERNAL TIER: services present it as X-Internal-Secret and agent-api/admin-api believe
# it as authority (the meeting room's gate 0). It shipped here as a literal, which meant every
# unconfigured deploy shared one published secret — mint your own, there is no default and the
# services refuse to boot without it:  openssl rand -hex 32
INTERNAL_API_SECRET=
# The runtime caller credential. The runtime starts containers on its callers' word, so every route
# but /health requires this bearer; agent-api and meeting-api present it, no spawned bot or worker
# holds it. No default — the runtime, agent-api and meeting-api refuse to boot without one (32+
# bytes). `make up` mints it here; by hand:  openssl rand -hex 32
RUNTIME_API_TOKEN=
# gateway-identity.v1 needs nothing here: the gateway's Ed25519 keypair is generated on first start
# by the `identity-keys` one-shot into two volumes — the private key mounted only by the gateway, the
# public key by agent-api, meeting-api and the credential broker. Remove `identity-signing-key` to
# rotate it.
# The worker toolbelt's delegation key: agent-api signs each worker's per-dispatch token with it and
# identity verifies it, so a worker reaches the gateway's /mcp as the person it acts for. Leave it
# empty and workers run without vexa tools (said in every spawn's log). mint-dev-env.sh generates it.
VEXA_MCP_DELEGATION_SECRET=
# The credential store's key: saved GitHub PATs and per-workspace deploy-key private halves are
# sealed with it (R-E08). Leave it empty in development and a key is generated under the workspaces
# volume, NEXT TO the ciphertext — enough against a stray read, nothing against a stolen volume or a
# backup, and agent-api warns on every boot that does it. Set VEXA_ENV=production and this becomes
# required: mint one and keep it outside the data volume.  openssl rand -hex 32
VEXA_SECRETS_KEY=
# The deployment profile — the same word the mcp and transcription services read. Anything but
# `production` (including unset) is a development posture: generated store key, public docs.
VEXA_ENV=development
# The bot's display name in the meeting — the terminal omits bot_name on join, so this names every
# bot it sends. Empty → Vexa. Restart meeting-api after changing; the terminal needs no rebuild.
DEFAULT_BOT_NAME=
# The key agent-api signs each dispatch's identity token with. No default (the old one was published
# here); agent-api refuses to boot on an unset or published value. mint-dev-env.sh generates it.
VEXA_DISPATCH_SIGNING_KEY=
# NEXTAUTH_SECRET — REQUIRED. Signs the terminal's sign-in cookies and emailed sign-in links; the
# terminal refuses to start without one of 32+ bytes. `make all` mints it here; by hand:
#   openssl rand -hex 32
NEXTAUTH_SECRET=
# NEXTAUTH_URL — the terminal's public origin (e.g. https://vexa.example.com, or
# http://localhost:13000 locally). Required for OAuth login and for the emailed sign-in link, which is
# built only from this value; an https:// value also flips the auth cookies to Secure.
NEXTAUTH_URL=

# OAuth login providers (terminal sign-in buttons). Each self-gates on its creds: set BOTH id+secret
# to expose that provider; leave empty to hide it (the emailed sign-in link always works).
# Register the redirect URI in the provider console: ${NEXTAUTH_URL}/api/auth/callback/{google|microsoft}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Your org's tenant id (a GUID) admits only that tenant's accounts. "common" admits any tenant, and
# then each sign-in must carry the `xms_edov` claim (add it as an optional ID-token claim in the app
# registration's Token configuration), or it is refused.
MICROSOFT_TENANT_ID=common

# ── The deployment's mail relay (VEXA_MAIL_SMTP_*) — one family for every sender ─────────────────
# The terminal mails the one-time sign-in link through it, and flows sends its mail through it.
# Unset HOST: the terminal dials the local dev double (localhost:1025 — nothing, inside a container,
# so no link is delivered) and flows uses Gmail with VEXA_MAIL_ADDR / VEXA_MAIL_APP_PASSWORD below.
# STARTTLS whenever the relay offers it (a provider's :587), certificate checked; SECURE=1 for a
# provider's implicit-TLS :465 endpoint; plain SMTP only to a relay that offers neither (e.g. Mailpit).
# USER + PASSWORD enable AUTH LOGIN when both are set, and only over TLS: a relay that offers neither
# is refused. TLS_INSECURE=1 skips certificate checks — dev only. PORT defaults to 25. FROM is the sign-in mail's
# sender (default "Vexa <no-reply@vexa.ai>"); flows sends as VEXA_MAIL_ADDR.
# (v0.13.0-v0.13.1 terminals read SMTP_HOST … SMTP_PASS; those names still work, with a warning.)
VEXA_MAIL_SMTP_HOST=
VEXA_MAIL_SMTP_PORT=25
VEXA_MAIL_SMTP_FROM=
VEXA_MAIL_SMTP_USER=
VEXA_MAIL_SMTP_PASSWORD=
VEXA_MAIL_SMTP_SECURE=
VEXA_MAIL_SMTP_TLS_INSECURE=

# ── Who may sign in to the terminal ──────────────────────────────────────────────────────────────
# Every door (emailed link, Google, Microsoft) admits only: an EXISTING user of this instance, an
# ADMIN, or an address on the sign-in allow-list. Anybody else is refused before an account exists;
# the emailed-link form answers "check your email" either way and sends nothing to them. admin-api
# reads both settings below and decides; the terminal only asks it.
#
# VEXA_ADMIN_EMAILS — the administrators, comma-separated full addresses. They may always sign in and
# are the admins; naming them closes the admin claim, so nobody else can take the role. Left empty,
# the first admin claims the instance with the one-time code admin-api logs at boot:
#   docker compose logs admin-api | grep -A4 'ADMIN CLAIM CODE'
# Without that code nobody new can sign in to an unclaimed instance.
VEXA_ADMIN_EMAILS=
# VEXA_SIGNIN_ALLOW — who else may sign in: exact addresses and whole domains, comma-separated.
#   e.g. VEXA_SIGNIN_ALLOW=@example.com,alice@example.org
# `@example.com` admits everyone at exactly that domain (a subdomain needs its own entry). Empty =
# nobody new once an admin exists. A non-empty list also means only these addresses may sign in or
# claim the admin role on an instance nobody has claimed yet. The admin can add entries in the
# terminal under Settings → Sign-in; the effective list is this value plus those. Read by admin-api
# — restart it to apply. `*` alone lets ANY address sign in (dev/demo stacks only; admin-api warns
# at boot while it is set).
VEXA_SIGNIN_ALLOW=

# ── Connections (the credential broker, docs: /connections) ─────────────────────────────────────
# Gmail, Google Calendar and custom-API connections for agents. Runs with no settings: the broker
# and its keys come up with the stack. Set VEXA_CONNECTIONS_BROKER_URL= (empty) to run without it.
# The origin browser saves must come from; empty = the origin of NEXTAUTH_URL.
VEXA_CONNECTIONS_PUBLIC_ORIGIN=
# Gmail + Calendar consent (optional; usually the client the terminal signs in with). Register
# https://<your terminal>/api/auth/callback/google on it. Empty = those two answer "not configured".
VEXA_CONNECTIONS_GOOGLE_CLIENT_ID=
VEXA_CONNECTIONS_GOOGLE_CLIENT_SECRET=
VEXA_CONNECTIONS_PRODUCT_REDIRECT=
# Store backend: local (AES-256-GCM in the broker's volume) or openbao (yours; set the three below
# and mount the token file into credential-broker).
VEXA_CONNECTIONS_STORE=local
VEXA_CONNECTIONS_OPENBAO_ADDR=
VEXA_CONNECTIONS_OPENBAO_TOKEN_FILE=
VEXA_CONNECTIONS_OPENBAO_MOUNT=connections
# Opt-in: keep agent-api's saved Git tokens and deploy keys in the broker. Set to
# http://credential-broker:8100 to switch; existing credentials move on first use.
VEXA_GIT_STORE_BROKER_URL=

# Google Analytics 4 (terminal web usage). Set to your measurement id (G-XXXXXXXXXX) to turn on
# frontend analytics — page views + an `api_request` event per web-client API call. Baked into the
# client bundle at BUILD time, so rebuild the terminal image after changing it. Empty → GA stays off.
GA_MEASUREMENT_ID=

# --- CREDENTIALS — fill these for transcription + agent intelligence ---------
# Transcription (STT): self-host the bundled service (deploy/transcription — GPU or CPU,
# deployed separately from this stack) and point URL at its load balancer (base URL; the client
# appends /v1/audio/transcriptions), e.g. http://<gpu-host>:8083. TOKEN must match that unit's
# API_TOKEN. Or use a hosted token from https://vexa.ai/account. Without it, bots join + record
# but produce no transcript.
TRANSCRIPTION_SERVICE_URL=
TRANSCRIPTION_SERVICE_TOKEN=
# STT model id sent on every transcription request (the OpenAI-compatible `model` field). Set it
# when the backend VALIDATES model ids — Groq (whisper-large-v3-turbo), OpenAI (whisper-1),
# vLLM/LiteLLM (the served name). Empty → whisper-1. The bundled deploy/transcription unit
# ignores this field: its model is the unit's own MODEL_SIZE.
TRANSCRIPTION_MODEL=
# Deployment-level defaults for a spawn's flags when the request does not say (config.v1 `defaulted`).
# TRANSCRIBE_ENABLED=false makes a no-STT deployment spawn capture-only bots instead of 503-ing every
# default POST /bots. Both default true — and LEFT EMPTY BELOW STILL MEANS true: only an explicit
# false/0/no/off opts out. (Empty used to resolve False on the `--env-file` path, silently shipping
# capture-only bots that transcribed nothing with no error — the v0.12.5 witness bug.)
TRANSCRIBE_ENABLED=
RECORDING_ENABLED=
# Authenticated-bot mode (deployment-scoped; docs: /authenticated-bots). BOT_AUTHENTICATED=true
# makes every spawned bot restore the provisioned browser session (make login) and join signed-in.
# BOT_S3_* are the bots' READ-ONLY userdata-store pair — never the deployment's admin S3 creds, and
# sharing neither half with MINIO_* / S3_* (POST /bots refuses that). With
# BOT_S3_ENDPOINT=http://storage:9000 the storage-init step creates that key pair as an account on
# the in-stack storage, read-only on BOT_USERDATA_S3_PATH (bucket policy: list + get). Bots hand
# their rotated session to meeting-api, which writes it with MINIO_*; `make login` uploads with
# LOGIN_S3_ACCESS_KEY / LOGIN_S3_SECRET_KEY set to MINIO_ACCESS_KEY / MINIO_SECRET_KEY.
BOT_AUTHENTICATED=
BOT_USERDATA_S3_PATH=
BOT_S3_ENDPOINT=
BOT_S3_BUCKET=
BOT_S3_ACCESS_KEY=
BOT_S3_SECRET_KEY=
# Optional generic service authority. Unset preserves the stock OSS allow-all behavior. When set,
# CONFIG is one compact JSON object with url/contract_version/timeout_ms/
# response_max_age_seconds/failure_policy=closed/mode=enforce|observe. SECRET signs exact request
# bytes; keep it out of source and shell history in real deployments.
VEXA_SERVICE_AUTHORITY_CONFIG=
VEXA_SERVICE_AUTHORITY_SECRET=
# Optional operator-owned terminal callback. Unlike the customer webhook, this destination is
# frozen at boot. Private HTTP requires the explicit opt-in; keep the secret out of source/history.
VEXA_SYSTEM_WEBHOOK_URL=
VEXA_SYSTEM_WEBHOOK_SECRET=
VEXA_SYSTEM_WEBHOOK_ALLOW_PRIVATE_HTTP=false
VEXA_SYSTEM_WEBHOOK_TIMEOUT_S=10
BOT_ALONE_SILENCE_WINDOW_MS=
BOT_SPEAKER_MIN_AUDIO_SEC=
BOT_SPEAKER_SUBMIT_INTERVAL_SEC=
BOT_SPEAKER_CONFIRM_THRESHOLD=
BOT_SPEAKER_MAX_BUFFER_SEC=
BOT_SPEAKER_IDLE_TIMEOUT_SEC=
# Self-hosted Jitsi hostnames (comma-separated, e.g. calls.example.org) recognized when parsing
# pasted meeting links AND calendar (ICS) links. meet.jit.si and hosts naming "jitsi" are always
# recognized; hosts with a "meet" label (meet.example.org, eu.meet.example.org) are recognized in
# pasted links. List a host here to make its calendar invites import as joinable Jitsi meetings.
VEXA_JITSI_HOSTS=

# There is ONE model in this product and it is the agent's (PRD decision 34). The VEXA_LLM_*
# block that stood here configured a SECOND one — the completion provider behind the live meeting
# copilot's "cleaned" transcript and card beats. That pipeline is removed; a meeting's live view
# shows the raw transcript and everything intelligent happens in the chat's agent over MCP.
#
# What survives is not that pipeline: these four configure the `openai-agent` HARNESS (decision 37)
# — our own agent loop over any OpenAI-compatible endpoint — and are read INSIDE the worker. They
# matter only when VEXA_RUNNER=openai-agent; leave them empty for claude-code.
VEXA_LLM_BASE_URL=
VEXA_LLM_API_KEY=
VEXA_LLM_MODEL=
# A JSON object merged into EVERY chat/completions request — the escape hatch for server-specific
# parameters the OpenAI dialect has no field for. A self-hosted Qwen NEEDS this one or it spends its
# whole token budget reasoning and returns no valid JSON:
#   VEXA_LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
VEXA_LLM_EXTRA_BODY=
VEXA_LLM_PROVIDER=
VEXA_LLM_MAX_TOKENS=
# Optional operator gate on workspace-pinned models (comma-separated; empty = allow any route).
VEXA_MODEL_ALLOWLIST=
# Operator allow-list for the ENDPOINT a subject may pin under Settings → Models (comma-separated
# host globs, e.g. `api.anthropic.com,*.internal.example.com`). A subject-chosen base_url is an
# outbound destination picked by a non-operator and the worker carries a model credential to it, so
# anything unmatched is refused at dispatch. Empty = the deployment's own gateway host(s) plus
# api.anthropic.com and openrouter.ai. Loopback / private / single-label docker names
# (redis, admin-api) must be named EXACTLY — a wildcard never reaches the deployment's own network.
VEXA_MODEL_BASE_URL_ALLOW=
# The MODEL CATALOG (ADR-0043): the models people pick per chat in the terminal, one JSON object on
# one line (models.v1 Catalog; docs: https://docs.vexa.ai/model-catalog). Empty = no catalog: every
# turn runs on VEXA_AGENT_MODEL / VEXA_RUNNER and each person's Settings -> Models, as before.
# Credentials are never written here: a provider names a variable (secret_ref env:VEXA_MODEL_SECRET_<NAME>,
# the only names a catalog may reach) set on its own line in this file. Two worked examples, a self-hosted Qwen 3 and one OpenRouter model:
#   VEXA_MODEL_CATALOG={"providers":{"lab-vllm":{"adapter":"openai_compatible","base_url":"http://10.0.0.5:8000/v1","auth":"none","extra_body":{"chat_template_kwargs":{"enable_thinking":false}}},"openrouter":{"adapter":"openrouter","auth":"secret","secret_ref":"env:VEXA_MODEL_SECRET_OPENROUTER"}},"models":[{"id":"qwen3-32b","display_name":"Qwen 3 32B (self-hosted)","provider":"lab-vllm","model":"Qwen/Qwen3-32B","capabilities":{"tool_calling":true,"streaming":true,"context_tokens":32768},"default":true},{"id":"or-sonnet","display_name":"Claude Sonnet via OpenRouter","provider":"openrouter","model":"anthropic/claude-sonnet-4.5"}]}
#   VEXA_MODEL_SECRET_OPENROUTER=<your OpenRouter key>
# agent-api refuses a catalog with any problem at boot and names each one.
VEXA_MODEL_CATALOG=
# The agent HARNESS for workspace turns (chat / routines / post-meeting docs) — a CLI coding agent.
# Harness runner: claude-code (default) | codex (Codex app-server) | openai-agent (this repo's
# own agent loop over any OpenAI-compatible endpoint — no CLI, no vendor; pair it with
# VEXA_LLM_BASE_URL + VEXA_LLM_MODEL + VEXA_LLM_EXTRA_BODY above).
VEXA_RUNNER=
# openai-agent per-turn budget and context ceiling (defaults 40 / 900 / 24000). The context ceiling
# is a SIZING rule on a shared inference box, not a nicety: a 24k-context request is ~1/29th of the
# KV cache, and a turn that grows unbounded evicts everybody else's.
VEXA_AGENT_MAX_TOOL_CALLS=
VEXA_AGENT_MAX_TURN_SEC=
VEXA_AGENT_CONTEXT_TOKENS=
# THE OUTPUT CAP, every harness: how many output tokens a model request asks for. Empty keeps each
# harness's own default — the claude CLI asks for 32000, and a provider that prices that allowance
# up front (OpenRouter) refuses a small balance with a 402 before answering. claude-code receives
# it as CLAUDE_CODE_MAX_OUTPUT_TOKENS; openai-agent sends it as max_tokens.
VEXA_AGENT_MAX_OUTPUT_TOKENS=
# …AND THE TOOL-CALL BUDGET IS PER KIND OF TURN (defaults 40 / 160 / 80 / 40). Four different
# amounts of work shared one number until Vexa-ai/vexa#1622: a chat sentence, a Create/Extend job
# window, a whole post-meeting room run, one flow step. Each row falls back to
# VEXA_AGENT_MAX_TOOL_CALLS above, so setting only that one still moves all four. See
# core/agent/llm/JOBS.md.
VEXA_AGENT_MAX_TOOL_CALLS_CHAT=
VEXA_AGENT_MAX_TOOL_CALLS_JOB=
VEXA_AGENT_MAX_TOOL_CALLS_ROOM=
VEXA_AGENT_MAX_TOOL_CALLS_FLOW=
# A CHAT turn that reaches its tool-call budget continues into a fresh window (1, the default), at
# most VEXA_AGENT_MAX_CHAT_CONTINUATIONS times (default 4; 0-50) and always inside
# VEXA_AGENT_MAX_TURN_SEC — so research in a chat is not cut off at 40 calls and no chat runs
# without end. 0 stops every chat turn at the budget with a Continue act instead.
VEXA_AGENT_AUTO_CONTINUE_CHAT=1
VEXA_AGENT_MAX_CHAT_CONTINUATIONS=4
# openai-agent SSE streaming (default on; 0 = one blocking request per step).
VEXA_AGENT_STREAM=
# ── WEB REACH for the openai-agent harness (WebSearch / WebFetch) ────────────────────────────────
# THE OPERATOR SUPPLIES THE SEARCH ENDPOINT. The harness speaks to an endpoint you run or already
# pay for; leaving this empty means the WebSearch tool is not attached to the turn at all (WebFetch
# needs no backend and is always attached). See docs/docs/agent-web-search.mdx.
#
#   VEXA_SEARCH_DIALECT=searxng  (default) — any endpoint that answers `GET /search?q=…&format=json`
#     with `{"results":[{title,url,content}]}`. Point it at your own, or start the one this repo
#     ships as an OPT-IN profile (`docker compose --profile search up -d searxng`):
#       VEXA_SEARCH_URL=http://searxng:8080
#   VEXA_SEARCH_DIALECT=brave — the Brave Search API; needs VEXA_SEARCH_API_KEY.
#       VEXA_SEARCH_URL=https://api.search.brave.com
VEXA_SEARCH_URL=
VEXA_SEARCH_DIALECT=
VEXA_SEARCH_API_KEY=
# The `search` profile's SearXNG sidecar. It is AGPL-3.0 and is NOT part of Vexa: an unmodified
# upstream image you pull and run beside the stack, never bundled into a vexaai/* artifact
# (image-licenses.json). Nothing starts unless you ask for the profile by name.
#   SEARXNG_HOST_PORT — loopback publish port for poking it from the host (compose DNS is unaffected).
#   SEARXNG_SECRET    — server.secret_key. SearXNG reads it from the ENVIRONMENT; it does not expand
#                       ${...} inside the mounted deploy/compose/searxng/settings.yml. Set a real one
#                       for anything that is not a local stack.
#   SEARXNG_IMAGE     — override the digest-pinned default only to bump it deliberately.
SEARXNG_HOST_PORT=
SEARXNG_SECRET=
SEARXNG_IMAGE=
# Optional Codex-specific model. Empty uses the signed-in subscription account's default and avoids
# inheriting an existing Claude model pin from Settings → Models.
VEXA_CODEX_MODEL=
# Enables same-turn message steering for either runner (Claude open stdin / Codex turn/steer).
VEXA_MIDTURN_INJECT=

# Codex SUBSCRIPTION credentials (VEXA_RUNNER=codex):
#   1. Run `codex login` on the Docker host.
#   2. Point this at that host's auth file (normally /home/<you>/.codex/auth.json or
#      /Users/<you>/.codex/auth.json). The runtime mounts it READ-ONLY into each worker at
#      $CODEX_HOME/auth.json (/tmp/.codex, which the runtime names as CODEX_HOME). Codex rollouts remain workspace-scoped; the auth file is never copied
#      into the workspace or committed.
HOST_CODEX_CREDENTIALS=

# Credentials for the claude-code harness ONLY (unused by other runners). Without them,
# capture + transcripts work but agent chat / workspace turns do not.
# Two delivery mechanisms into spawned workers:
#   1) env passthrough — agent-api stamps the model-auth allowlist (CLAUDE_CODE_OAUTH_TOKEN,
#      ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN / ANTHROPIC_BASE_URL) from its own env into
#      every dispatch spec env. Works on EVERY runtime
#      backend (docker/compose, k8s/helm, process/lite) — on helm it is the ONLY path.
#   2) HOST_CLAUDE_CREDENTIALS bind-mount (docker backend only, "optional" below) — the runtime
#      mounts a host ~/.claude/.credentials.json read-only into the worker.
# If both are configured, the claude CLI prefers its env credential over the mounted file —
# configure exactly one to avoid ambiguity.
# CLAUDE_CODE_OAUTH_TOKEN = the claude CLI subscription OAuth token (env twin of the mount).
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
VEXA_AGENT_MODEL=

# --- optional ----------------------------------------------------------------
# Bot API key — fallback auth for the terminal's proxy auth chain:
# cookie token → VEXA_API_KEY → VEXA_BOT_API_KEY → "". Set to a token minted
# by `make provision-token` (same scopes: bot,tx). Leave empty if unused.
VEXA_BOT_API_KEY=
VEXA_AGENT_SRC_MOUNT=

# The organisation tier (`_global`) every agent worker mounts read-only. LEAVE EMPTY: agent-api then
# keeps it in the workspaces volume (/workspaces/_global) and creates it empty at boot, so chat
# dispatches with nothing configured — an empty `_global` is fine. Set a HOST path only to manage
# `_global` as a separate repo outside the store; REF pins that repo to a branch/tag/sha.
VEXA_GLOBAL_SYSTEM_WORKSPACE_PATH=
VEXA_GLOBAL_SYSTEM_WORKSPACE_REF=

# Claude SUBSCRIPTION credentials for agent workers (the claude-code runner's no-API-key path).
# HOW IT WORKS (explicit + deterministic — config.v1 `model_inference` capability):
#   1. Set this to a path ON THE DOCKER HOST (not inside any container) of a claude credentials
#      JSON — typically $HOME/.claude/.credentials.json after `claude login` on the host.
#   2. The runtime bind-mounts that host file READ-ONLY into EVERY spawned agent-worker at
#      /root/.claude/.credentials.json (core/runtime docker backend); the worker's claude CLI
#      authenticates from it. No key material passes through env.
#   3. The same path is mirror-mounted into the runtime container so its config.v1 file probe can
#      verify the file exists + parses; a bad path shows as `model_inference: misconfigured` on the
#      runtime's /health (docker silently turns a missing host path into an empty directory in the
#      worker, which otherwise only surfaces as 'Model inference failed: Not logged in' at chat time).
#   4. ALSO SET HOST_CLAUDE_DIR (below) — the directory that holds this file. Without it, the two
#      long-lived containers go stale the first time the CLI refreshes the token.
# macOS ONLY: the CLI's real store is the login Keychain — this file is a one-time export that
# expires every ~8-12h (agent chat then 401s while `claude` still works). Install the bundled
# refresher once: deploy/bin/claude-creds-sync/install.sh (Linux/WSL2 need nothing — the CLI
# refreshes the file itself). See deploy/bin/claude-creds-sync/README.md.
# Alternative credential path: leave this empty and set ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN
# (+ ANTHROPIC_BASE_URL) above — the runtime brokers those into workers as env instead.
HOST_CLAUDE_CREDENTIALS=

# The DIRECTORY that holds the file above ($HOME/.claude). SET BOTH — this one is not optional in
# practice, it is what keeps the credential FRESH.
#
# THE INODE TRAP. A `-v /host/file:/container/file` bind is resolved once, at container create, and
# the kernel pins that INODE. The claude CLI refreshes an expiring OAuth token by writing a temp
# file and rename(2)-ing it over .credentials.json — atomically, with a NEW inode — so the mount
# inside a long-lived container still points at the old, now-unlinked one. runtime and agent-api
# then read the pre-refresh token FOREVER (until recreated) while `claude` on the host works
# perfectly, and every chat turn is refused with "No model credentials are configured". That cost
# 32h of dead agents on the dogfood stack (2026-08-31 → 09-01). Measured:
#     file mount, before replace: ORIGINAL     dir mount: ORIGINAL
#     file mount, after  replace: ORIGINAL     dir mount: REFRESHED
# A DIRECTORY bind tracks the directory inode and resolves the filename on every read, so the
# refresh is visible immediately with nothing to recreate. Spawned workers were never affected —
# each one is a new container, so its bind resolves the current inode at spawn.
#
# Leave empty and everything still works exactly as before (the legacy single-file mount is the
# fallback) — it just goes stale on the next refresh.
HOST_CLAUDE_DIR=

# agent-api → meeting-api (SSE stream ownership check)
VEXA_MEETING_API_URL=http://meeting-api:8080

# --- gateway edge guard (fastapi-guard) ---------------------------------------
# Per-IP rate limiting + auto-IP-ban at the gateway edge. ON BY DEFAULT with generous limits
# (600 requests/min per IP) — to opt OUT, uncomment GUARD_ENABLED=false. All GUARD_* keys below
# interpolate into the gateway service via docker-compose.yml (`${VAR:-default}`), so setting any
# of them in this file takes effect on the next `docker compose up`.
# GUARD_WS_ENABLED is the optional /ws connect guard (off by default, opt-in): in-memory
# per-process — does NOT share ban/rate-limit state with the Redis-backed HTTP layer, and under
# uvicorn --workers N>1 each worker keeps an independent WS ban set. See
# core/gateway/services/gateway/src/gateway/edge_guard.py for the full GUARD_* surface.
#GUARD_ENABLED=false              # uncomment to turn the edge guard OFF
#GUARD_WS_ENABLED=false
#GUARD_ENABLE_REDIS=true          # reuse REDIS_URL for guard state (vexa:guard: namespace)
#GUARD_RATE_LIMIT_RPM=600         # per-IP requests per minute (0 disables rate limiting)
#GUARD_RATE_LIMIT_WINDOW=60
#GUARD_AUTO_BAN_THRESHOLD=10
#GUARD_AUTO_BAN_DURATION=3600
#GUARD_IP_BLACKLIST=             # comma-separated IPs to block (403)
#GUARD_IP_WHITELIST=             # comma-separated IPs to bypass the guard
#GUARD_TRUSTED_PROXIES=          # comma-separated trusted proxy IPs (enables X-Forwarded-For resolution)
#GUARD_BLOCKED_COUNTRIES=
#GUARD_BLOCK_CLOUD_PROVIDERS=

# --- Deprecated 0.10 dashboard (opt-in: docker compose --profile dashboard up -d) — #813 ---
# Pinned external image + host port; public URLs only matter behind a domain/reverse-proxy.
# DASHBOARD_IMAGE=vexaai/dashboard:0.10.6.3.14
# DASHBOARD_PORT=13001
# DASHBOARD_URL=http://localhost:13001
# DASHBOARD_PUBLIC_API_URL=http://localhost:18056
# DASHBOARD_PUBLIC_WS_URL=ws://localhost:18056/ws
# DASHBOARD_ALLOW_REGISTRATIONS=true

# --- The worker toolbelt (shared.delegation) ---
# agent-api mints a SHORT-LIVED, SCOPED delegation token per dispatch (VEXA_MCP_DELEGATION_SECRET,
# above) and the worker attaches it as a bearer header to VEXA_MCP_URL — by default the gateway's
# /mcp, the one assembled MCP server. The grant is revoked when the worker's unit ends, and dies on
# its own at exp. Override the URL only to point workers at a different MCP server. The lifetime
# defaults to the chat warm window plus one turn (VEXA_CHAT_IDLE_TIMEOUT_SEC + 900 = 1800 s).
# VEXA_MCP_URL=http://gateway:8000/mcp
# VEXA_MCP_DELEGATION_TTL_SEC=1800

# agent-api → admin-api, for ONE question: resolve a post-meeting participant's email to a subject
# so the room can mount their desk. LEAVE IT EMPTY unless you need that: it is admin-api's broad
# admin token (it can also create and patch users), and unset simply means the room mounts zero
# desks rather than guessing who someone is. Set it to the same value as ADMIN_TOKEN if you want
# the room to resolve participants. Goes away when admin-api grows a by-email route that returns
# only an id.
VEXA_ADMIN_API_TOKEN=

# Where a person's own terminal lives — the origin every SCAFFOLD link is built on (PRD §5.5), and
# the same variable the flows lane already reads. Unset, agent-api's mint route answers 503 and the
# step that was about to send does not: a link with no origin is a touch nobody can open, and it is
# only visible at the CLICK unless the mint refuses. VEXA_UI_URL being set nowhere is exactly how
# every deeplink the rig ever minted pointed at a port nothing serves.
VEXA_UI_URL=

# ── flows: the reaction engine (flows-api) and its mail lane (flows-mailbox, profile `mailbox`) ──
# Every key below is declared in core/flows/src/config.v1.json and checked against docker-compose.yml
# by gate:config-contract. Both flows lanes read the same set: they are one image under two commands.

# The operator key gating POST /flows and POST /events. NO DEFAULT ON PURPOSE — flows refuses to
# start without it, and refuses the published placeholders (`changeme`, `vexa-internal-secret`, …)
# by name. `openssl rand -hex 32`.
VEXA_FLOWS_API_KEY=
# admin-api's admin key under the name flows reads it by. Defaults to ADMIN_TOKEN; set it only to
# give flows a different credential from the one the rest of the stack uses.
VEXA_FLOWS_ADMIN_KEY=
# A read-only key that opens GET /timeline and nothing else. Unset, only the operator key does.
VEXA_FLOWS_TIMELINE_KEY=
# agent-api's internal tier. UNSET MEANS THIS DEPLOYMENT DOES NOT RUN THE AGENT DOMAIN (PRD 40.7):
# flow steps that would dispatch an agent turn answer `not_present`. That is a product, not a fault.
VEXA_FLOWS_AGENT_API_URL=
# Where the assembler asks flows for its tool manifest. Defaults to the service; set it EMPTY to run
# a deployment that does not carry the flows domain at all.
VEXA_FLOWS_API_URL=
FLOWS_API_HOST_PORT=18200

# The mailbox. Empty = no mail intake, which is what the `mailbox` profile being off means.
VEXA_MAIL_ADDR=
VEXA_MAIL_APP_PASSWORD=
VEXA_MAIL_INBOX=imap
# (the outbound relay, VEXA_MAIL_SMTP_*, is set once for the whole deployment — see above)
VEXA_MAILPIT_URL=
VEXA_MAILPIT_LOOKBACK_S=300
VEXA_NOTIFY_CHANNEL=smtp
# MICROSOFT 365 OVER GRAPH — set VEXA_MAIL_INBOX=graph and VEXA_NOTIFY_CHANNEL=graph, and fill in
# ALL FOUR of these. For a tenant that exposes neither IMAP nor SMTP AUTH (the common bank
# posture); a tenant that DOES allow IMAP does not need them. The app registration needs
# APPLICATION permissions Mail.ReadWrite + Mail.Send with admin consent, and an Exchange
# ApplicationAccessPolicy scoping it to the one mailbox — without that policy the credential
# reads every mailbox in the tenant.
VEXA_GRAPH_TENANT_ID=
VEXA_GRAPH_CLIENT_ID=
VEXA_GRAPH_CLIENT_SECRET=
VEXA_GRAPH_MAILBOX=
# WHO THE MAILBOX WILL ACT FOR (R-B12). UNSET IS NOT `EVERYONE` — it means the mailbox's own
# domain, so empty is the safe value here and not a hole. Comma-separated, with or without a `@`.
VEXA_FLOWS_MAIL_DOMAINS=
# `1` answers a quarantined stranger ONCE with a fixed one-liner. Off by default: any automatic
# reply to an unverified sender is a reflector.
VEXA_FLOWS_MAIL_QUARANTINE_REPLY=
# The ceilings on what one inbox can cost, per sender and for the whole deployment, per window.
VEXA_FLOWS_MAIL_RATE_PER_SENDER=12
VEXA_FLOWS_MAIL_RATE_GLOBAL=120
VEXA_FLOWS_MAIL_RATE_WINDOW_S=3600
VEXA_FLOWS_MAIL_BODY_MAX=4000

# The OUTBOUND fan-out allow-list; unset = the organizer's own domain. And this deployment's own
# sentence about where the words live, carried in what it mails.
VEXA_FLOWS_ATTENDEE_DOMAINS=
VEXA_FLOWS_DATA_STATEMENT=
# A private behavior tree mounted over the showcase baked into the image (PRD decision 12).
# EMPTY IS THE OSS PRODUCT.
VEXA_BEHAVIOR_DIR=
VEXA_FLOWS_USER_KEY_TTL_S=900
VEXA_TIMELINE_SCAN_ROWS=2000
