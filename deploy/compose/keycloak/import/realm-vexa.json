  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@vexa.local",
    "fromDisplayName": "Vexa",
    "replyTo": "",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "requiredActions": [
    {
      "alias": "VERIFY_EMAIL",
