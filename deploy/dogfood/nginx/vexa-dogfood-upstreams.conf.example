# /etc/nginx/conf.d/vexa-dogfood-upstreams.conf — GENERATED by deploy/dogfood/bin/deploy.sh.
#
# One upstream per blue/green service, each naming the host port of the container serving it right
# now. deploy.sh rewrites this file and reloads; rollback.sh writes the previous ports back. Do not
# hand-edit it except at adoption, when it has to be seeded with what is currently serving.
#
# Seed it from `docker ps` — the port on the LEFT of the arrow for each container:
#   vexa-dogfood-agent-api-1        127.0.0.1:18500->8100/tcp
#   vexa-dogfood-runtime-1          127.0.0.1:18490->8090/tcp
#   vexa-minutes-terminal           127.0.0.1:15401->3000/tcp

upstream vexa_agent_api { server 127.0.0.1:18500; }
upstream vexa_runtime   { server 127.0.0.1:18490; }
upstream vexa_app       { server 127.0.0.1:15401; }
