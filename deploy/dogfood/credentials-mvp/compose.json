{
  "services": {
    "bao": {
      "image": "ghcr.io/openbao/openbao@sha256:71156a1c6623a5fa3f5e61b0c6a8ead0faf0df29a778339188443551995d1315",
      "user": "1001:1001",
      "entrypoint": [
        "bao"
      ],
      "command": [
        "server",
        "-config=/bao/config/bao.hcl"
      ],
      "volumes": [
        "./bao.hcl:/bao/config/bao.hcl:ro",
        "./state/bao-v2:/bao/data",
        "./state/audit:/bao/audit"
      ],
      "networks": [
        "vault"
      ],
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "mem_limit": "256m",
      "memswap_limit": "256m"
    },
    "broker": {
      "image": "sha256:07c3994657e0e0ea4f192d66833833f8a7b6620f106e4977e20c595594f0d4b4",
      "user": "1001:1001",
      "working_dir": "/mvp",
      "command": [
        "uvicorn",
        "app:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8100",
        "--no-access-log"
      ],
      "environment": {
        "BAO_ADDR": "http://bao:8200",
        "FIXTURE_URL": "http://fixture:8100",
        "MVP_ORIGIN": "http://localhost:18541",
        "PYTHONDONTWRITEBYTECODE": "1",
        "MVP_OAUTH_CONFIG": "vault",
        "MVP_OAUTH_REDIRECT": "http://localhost:3001/api/auth/callback/google"
      },
      "volumes": [
        "./app.py:/mvp/app.py:ro",
        "./index.html:/mvp/index.html:ro",
        "./app.js:/mvp/app.js:ro",
        "./style.css:/mvp/style.css:ro",
        "./state/broker:/state",
        "./providers.py:/mvp/providers.py:ro",
        "./vault_client.py:/mvp/vault_client.py:ro",
        "./product_identity.py:/mvp/product_identity.py:ro",
        "./secret_service.py:/mvp/secret_service.py:ro"
      ],
      "ports": [
        "127.0.0.1:18541:8100"
      ],
      "networks": [
        "vault",
        "connector",
        "web"
      ],
      "read_only": true,
      "tmpfs": [
        "/tmp"
      ],
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "mem_limit": "256m",
      "memswap_limit": "256m"
    },
    "fixture": {
      "image": "sha256:07c3994657e0e0ea4f192d66833833f8a7b6620f106e4977e20c595594f0d4b4",
      "user": "1001:1001",
      "working_dir": "/mvp",
      "command": [
        "uvicorn",
        "fixture:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8100",
        "--no-access-log"
      ],
      "environment": {
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "volumes": [
        "./fixture.py:/mvp/fixture.py:ro",
        "./state/fixture:/fixture:ro"
      ],
      "networks": [
        "connector"
      ],
      "read_only": true,
      "tmpfs": [
        "/tmp"
      ],
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "mem_limit": "128m",
      "memswap_limit": "128m"
    }
  },
  "networks": {
    "vault": {
      "internal": true
    },
    "connector": {
      "internal": true
    },
    "web": {}
  }
}
