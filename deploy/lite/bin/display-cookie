#!/usr/bin/env python3
"""display-cookie <authority-file> <display-number> <group> — write a fresh X authority file for the
shared Xvfb display: one random MIT-MAGIC-COOKIE-1, for this host and for any address (the entries
Xvfb's -auth and every client look up), owned root:<group> 0640 in a root:<group> 0750 directory.

Xvfb runs with access control on (no -ac), so only a process that can read this file can open the
display: root's own programs and the members of <group>, which the runtime gives to meeting bots and
not to agent workers. Run at every container start, before supervisord starts Xvfb, so a restart gets
a new cookie. Prints nothing but errors; never the cookie.
"""
import grp
import os
import secrets
import socket
import struct
import sys

FAMILY_LOCAL, FAMILY_WILD = 256, 65535
NAME = b"MIT-MAGIC-COOKIE-1"


def entry(family: int, address: bytes, number: bytes, data: bytes) -> bytes:
    out = struct.pack(">H", family)
    for field in (address, number, NAME, data):
        out += struct.pack(">H", len(field)) + field
    return out


def main(argv):
    if len(argv) != 4:
        print("usage: display-cookie <authority-file> <display-number> <group>", file=sys.stderr)
        return 2
    path, number, group = argv[1], argv[2].encode(), argv[3]
    gid = grp.getgrnam(group).gr_gid
    directory = os.path.dirname(path)
    try:
        os.mkdir(directory, 0o750)              # its parent is the entrypoint's, made with its own mode
    except FileExistsError:
        pass
    os.chown(directory, 0, gid)
    os.chmod(directory, 0o750)
    cookie = secrets.token_bytes(16)
    data = (entry(FAMILY_LOCAL, socket.gethostname().encode(), number, cookie)
            + entry(FAMILY_WILD, b"", number, cookie))
    tmp = f"{path}.{secrets.token_hex(4)}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(data)
        os.fchown(f.fileno(), 0, gid)
        os.fchmod(f.fileno(), 0o640)
    os.replace(tmp, path)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
