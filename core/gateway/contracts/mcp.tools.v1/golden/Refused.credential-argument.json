{
  "why": "a credential in an argument list is in the transcript forever; the edge has one authentication path",
  "manifest": {
    "contract": "mcp.tools.v1",
    "domain": "agent",
    "source": "oss",
    "depends_on": [
      "identity"
    ],
    "base_url_env": "AGENT_API_URL",
    "tools": [
      {
        "name": "t",
        "identity": "user",
        "auth": "subject",
        "requires": [
          "identity",
          "agent"
        ],
        "route": {
          "method": "GET",
          "path": "/api/t"
        },
        "arguments": [
          "meeting_id",
          " API_Key "
        ]
      }
    ]
  }
}
