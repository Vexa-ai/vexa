{
  "why": "a key the contract does not name is a promise no loader reads; a new one is a contract change",
  "manifest": {
    "contract": "mcp.tools.v1",
    "domain": "agent",
    "source": "oss",
    "depends_on": [
      "identity"
    ],
    "base_url_env": "AGENT_API_URL",
    "tools": [
      {
        "name": "t",
        "identity": "user",
        "auth": "subject",
        "requires": [
          "identity",
          "agent"
        ],
        "route": {
          "method": "GET",
          "path": "/api/t"
        },
        "person_only": true
      }
    ]
  }
}
