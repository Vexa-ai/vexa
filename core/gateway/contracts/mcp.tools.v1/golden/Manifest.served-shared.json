{
  "contract": "mcp.tools.v1",
  "domain": "agent",
  "source": "oss",
  "owner": "core/agent",
  "base_url_env": "AGENT_API_URL",
  "served_at": "/.well-known/mcp-tools.json",
  "depends_on": [
    "identity"
  ],
  "forward": {
    "edge_prefix": "/agent/",
    "upstream_prefix": "/api/"
  },
  "tools": [
    {
      "name": "workspace_read",
      "identity": "user",
      "auth": "subject",
      "requires": [
        "identity",
        "agent"
      ],
      "route": {
        "method": "GET",
        "path": "/api/workspace/file"
      },
      "shared": "allow"
    },
    {
      "name": "people_followups",
      "identity": "user",
      "auth": "subject",
      "requires": [
        "identity",
        "agent"
      ],
      "route": {
        "method": "GET",
        "path": "/api/people/followups"
      },
      "shared": "refuse"
    }
  ]
}
