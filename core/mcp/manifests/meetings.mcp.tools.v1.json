{
  "contract": "mcp.tools.v1",
  "domain": "meetings",
  "source": "oss",
  "owner": "core/meetings/services/meeting-api",
  "base_url_env": "MEETING_API_URL",
  "served_at": "/.well-known/mcp-tools.json",
  "depends_on": [
    "identity"
  ],
  "tools": [
    {
      "name": "bot_config",
      "identity": "user",
      "route": {
        "method": "PUT",
        "path": "/bots/{platform}/{native}/config"
      },
      "requires": [
        "identity",
        "meetings"
      ],
      "note": "PER MEETING, and now also PER PERSON: the person's default bot_name lives here, keyed by person id, next to the per-meeting override \u2014 a bot default is a fact about the bot, and the bot is this domain's. It used to live in a workspace file in the agent domain, which is why `bot_send` needed two doors."
    },
    {
      "name": "bot_say",
      "identity": "user",
      "route": {
        "method": "POST",
        "path": "/bots/{platform}/{native}/speak"
      },
      "note": "asked_by_a_human stays a required argument, enforced in the route",
      "requires": [
        "identity",
        "meetings"
      ]
    },
    {
      "name": "bot_send",
      "identity": "user",
      "route": {
        "method": "POST",
        "path": "/bots"
      },
      "requires": [
        "identity",
        "meetings"
      ],
      "note": "ONE GATEWAY FORWARD. meeting-api resolves the person's default bot_name INTERNALLY \u2014 same domain, no second door. The version in core/mcp reads it from agent-api first, which is meetings->agent and is what this ruling forbids."
    },
    {
      "name": "bot_stop",
      "identity": "user",
      "route": {
        "method": "DELETE",
        "path": "/bots/{platform}/{native}"
      },
      "requires": [
        "identity",
        "meetings"
      ]
    },
    {
      "name": "bots_running",
      "identity": "user",
      "route": {
        "method": "GET",
        "path": "/bots/status"
      },
      "requires": [
        "identity",
        "meetings"
      ]
    },
    {
      "name": "captions_to_segments",
      "identity": "user",
      "route": {
        "method": "POST",
        "path": "/transcripts/convert"
      },
      "note": "NEW ROUTE. Today a local parser in the tool; no service takes an unparsed track",
      "requires": [
        "identity",
        "meetings"
      ]
    },
    {
      "name": "meeting_delete",
      "identity": "user",
      "route": {
        "method": "DELETE",
        "path": "/meetings/{meeting_id}"
      },
      "requires": [
        "identity",
        "meetings"
      ]
    },
    {
      "name": "meeting_info",
      "identity": "user",
      "route": {
        "method": "GET",
        "path": "/meetings/{meeting_id}"
      },
      "requires": [
        "identity",
        "meetings"
      ]
    },
    {
      "name": "meeting_participants",
      "identity": "user",
      "route": {
        "method": "GET",
        "path": "/meetings/{platform}/{native}/participants"
      },
      "requires": [
        "identity",
        "meetings"
      ]
    },
    {
      "name": "meeting_seed",
      "identity": "user",
      "route": {
        "method": "POST",
        "path": "/meetings/seed"
      },
      "note": "NEW ROUTE: the create+import pair becomes one route",
      "requires": [
        "identity",
        "meetings"
      ]
    },
    {
      "name": "meeting_transcript",
      "identity": "user",
      "route": {
        "method": "GET",
        "path": "/transcripts/by-id/{meeting_id}"
      },
      "note": "the since-cursor and tail windowing move into the route's query",
      "requires": [
        "identity",
        "meetings"
      ]
    },
    {
      "name": "meeting_update",
      "identity": "user",
      "route": {
        "method": "PATCH",
        "path": "/meetings/{meeting_id}"
      },
      "note": "falls through to POST /meetings/{platform}/{native}/annotate on 409",
      "requires": [
        "identity",
        "meetings"
      ]
    },
    {
      "name": "meetings_list",
      "identity": "user",
      "route": {
        "method": "GET",
        "path": "/meetings"
      },
      "requires": [
        "identity",
        "meetings"
      ]
    },
    {
      "name": "recordings_list",
      "identity": "user",
      "route": {
        "method": "GET",
        "path": "/recordings"
      },
      "requires": [
        "identity",
        "meetings"
      ]
    },
    {
      "name": "transcript_search",
      "identity": "user",
      "route": {
        "method": "GET",
        "path": "/transcripts/search"
      },
      "requires": [
        "identity",
        "meetings"
      ]
    },
    {
      "name": "transcript_terms",
      "identity": "user",
      "route": {
        "method": "GET",
        "path": "/transcripts/{meeting_id}/terms"
      },
      "note": "The extractor is mechanical and belongs beside the transcript. `known/unknown` needs the entity index, which only the agent domain has \u2014 so without it every term comes back `known: null`, which is a smaller answer, not an error.",
      "enriched_by": [
        {
          "domain": "agent",
          "route": {
            "method": "GET",
            "path": "/api/entity-index"
          },
          "adds": "which named terms already have a page the caller can open"
        }
      ],
      "requires": [
        "identity",
        "meetings"
      ]
    },
    {
      "name": "zoom_transcript_to_segments",
      "identity": "user",
      "route": {
        "method": "POST",
        "path": "/transcripts/convert"
      },
      "note": "NEW ROUTE. Same route, format=zoom",
      "requires": [
        "identity",
        "meetings"
      ]
    }
  ],
  "publishes_events": [
    {
      "event": "meeting.upcoming",
      "status": "published today",
      "triggers": "meeting_prep v1"
    },
    {
      "event": "meeting.completed",
      "status": "published today",
      "triggers": "post_meeting v4"
    },
    {
      "event": "meeting.started",
      "status": "emitted, NOT a registered trigger",
      "triggers": "nothing yet \u2014 the live_now row of whats_waiting depends on registering it"
    }
  ]
}
