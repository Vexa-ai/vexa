{
  "contract": "routes.v1",
  "domain": "identity",
  "owner": "core/identity",
  "edge": "gateway",
  "note": "The person's own account surface: calendar connections, webhook config, model and transcription preferences, the person's own settings and workspace regime, and their own photo.",
  "presence_env": "ADMIN_API_URL",
  "routes": [
    {
      "method": "GET",
      "path": "/user/calendar",
      "scopes": [
        "bot"
      ],
      "shared": "refuse"
    },
    {
      "method": "PUT",
      "path": "/user/calendar",
      "scopes": [
        "bot"
      ],
      "shared": "refuse"
    },
    {
      "method": "GET",
      "path": "/user/calendars",
      "scopes": [
        "bot"
      ],
      "shared": "refuse"
    },
    {
      "method": "POST",
      "path": "/user/calendars",
      "scopes": [
        "bot"
      ],
      "shared": "refuse"
    },
    {
      "method": "DELETE",
      "path": "/user/calendars/{calendar_id}",
      "scopes": [
        "bot"
      ],
      "shared": "refuse"
    },
    {
      "method": "PATCH",
      "path": "/user/calendars/{calendar_id}",
      "scopes": [
        "bot"
      ],
      "shared": "refuse"
    },
    {
      "method": "GET",
      "path": "/user/models",
      "scopes": [
        "bot",
        "tx"
      ],
      "shared": "refuse"
    },
    {
      "method": "PUT",
      "path": "/user/models",
      "scopes": [
        "bot",
        "tx"
      ],
      "shared": "refuse"
    },
    {
      "method": "GET",
      "path": "/user/transcription",
      "scopes": [
        "bot",
        "tx"
      ],
      "shared": "refuse"
    },
    {
      "method": "PUT",
      "path": "/user/transcription",
      "scopes": [
        "bot",
        "tx"
      ],
      "shared": "refuse"
    },
    {
      "method": "GET",
      "path": "/user/webhook",
      "scopes": [
        "bot",
        "tx"
      ],
      "shared": "refuse"
    },
    {
      "method": "PUT",
      "path": "/user/webhook",
      "scopes": [
        "bot",
        "tx"
      ],
      "shared": "refuse"
    },
    {
      "method": "GET",
      "path": "/user/settings",
      "scopes": [
        "bot",
        "tx"
      ],
      "mcp_reentry": true,
      "shared": "refuse"
    },
    {
      "method": "PUT",
      "path": "/user/settings",
      "scopes": [
        "bot",
        "tx"
      ],
      "mcp_reentry": true,
      "shared": "refuse"
    },
    {
      "method": "GET",
      "path": "/user/workspace-regime",
      "scopes": [
        "bot",
        "tx"
      ],
      "mcp_reentry": true,
      "shared": "refuse"
    },
    {
      "method": "PUT",
      "path": "/user/workspace-regime",
      "scopes": [
        "bot",
        "tx"
      ],
      "mcp_reentry": true,
      "shared": "refuse"
    },
    {
      "method": "GET",
      "path": "/user/photo",
      "scopes": [
        "bot",
        "tx"
      ],
      "shared": "refuse"
    },
    {
      "method": "PUT",
      "path": "/user/photo",
      "scopes": [
        "bot",
        "tx"
      ],
      "shared": "refuse"
    },
    {
      "method": "DELETE",
      "path": "/user/photo",
      "scopes": [
        "bot",
        "tx"
      ],
      "shared": "refuse"
    },
    {
      "method": "GET",
      "path": "/user/notifications",
      "scopes": [
        "bot",
        "tx"
      ],
      "shared": "refuse"
    },
    {
      "method": "PUT",
      "path": "/user/notifications",
      "scopes": [
        "bot",
        "tx"
      ],
      "shared": "refuse"
    },
    {
      "method": "GET",
      "path": "/user/profile",
      "scopes": [
        "bot",
        "tx"
      ],
      "shared": "refuse"
    },
    {
      "method": "PUT",
      "path": "/user/profile",
      "scopes": [
        "bot",
        "tx"
      ],
      "shared": "refuse"
    },
    {
      "method": "POST",
      "path": "/user/profile/withdraw",
      "scopes": [
        "bot",
        "tx"
      ],
      "shared": "refuse"
    },
    {
      "method": "POST",
      "path": "/user/company-verification",
      "scopes": [
        "bot",
        "tx"
      ],
      "shared": "refuse"
    },
    {
      "method": "POST",
      "path": "/user/company-verification/check",
      "scopes": [
        "bot",
        "tx"
      ],
      "shared": "refuse"
    },
    {
      "method": "GET",
      "path": "/user/directory/profiles",
      "scopes": [
        "bot",
        "tx"
      ],
      "shared": "refuse"
    },
    {
      "method": "GET",
      "path": "/user/directory/profiles/{handle}",
      "scopes": [
        "bot",
        "tx"
      ],
      "shared": "refuse"
    }
  ]
}
