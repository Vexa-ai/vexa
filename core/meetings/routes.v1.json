{
  "contract": "routes.v1",
  "domain": "meetings",
  "owner": "core/meetings",
  "edge": "gateway",
  "note": "Bots, meeting records, transcripts, recordings \u2014 and the two calendar SYNC verbs, which run against the feed meeting-api owns even though the connection itself is identity's. A row with `mcp_reentry` is one the MCP's own meeting tools call back into (core/meetings/services/mcp/src/vexa_mcp/app.py): a worker's token is admitted there on the MCP's re-entry, and on no other row. A row with `upstream` is forwarded to that path on meeting-api rather than its own; meeting-api reads this file to check, for each of its routes, the scopes of the rows that reach it (meeting_api/route_scopes.py).",
  "presence_env": "MEETING_API_URL",
  "routes": [
    {
      "method": "GET",
      "path": "/bots",
      "scopes": [
        "bot"
      ]
    },
    {
      "method": "POST",
      "path": "/bots",
      "scopes": [
        "bot"
      ],
      "mcp_reentry": true
    },
    {
      "method": "GET",
      "path": "/bots/status",
      "scopes": [
        "bot"
      ],
      "mcp_reentry": true
    },
    {
      "method": "DELETE",
      "path": "/bots/{platform}/{native_meeting_id}",
      "scopes": [
        "bot"
      ],
      "mcp_reentry": true
    },
    {
      "method": "GET",
      "path": "/bots/{platform}/{native_meeting_id}/chat",
      "scopes": [
        "bot"
      ],
      "mcp_reentry": true
    },
    {
      "method": "PUT",
      "path": "/bots/{platform}/{native_meeting_id}/config",
      "scopes": [
        "bot"
      ],
      "mcp_reentry": true
    },
    {
      "method": "POST",
      "path": "/bots/{platform}/{native_meeting_id}/speak",
      "scopes": [
        "bot"
      ],
      "mcp_reentry": true
    },
    {
      "method": "GET",
      "path": "/meetings",
      "scopes": [
        "tx"
      ],
      "mcp_reentry": true
    },
    {
      "method": "POST",
      "path": "/meetings",
      "scopes": [
        "tx"
      ]
    },
    {
      "method": "POST",
