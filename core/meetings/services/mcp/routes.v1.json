{
  "contract": "routes.v1",
  "domain": "mcp",
  "owner": "core/meetings/services/mcp",
  "edge": "gateway",
  "note": "The MCP front door. Its tools call BACK through this gateway with the caller's own key, so /bots is gated on that second hop too; this is the first hop. Every row admits a worker's own delegation token (`delegation`): the MCP is that token's audience.",
  "presence_env": "MCP_URL",
  "routes": [
    {
      "method": "DELETE",
      "path": "/mcp",
      "scopes": [
        "bot",
        "tx"
      ],
      "delegation": true
    },
    {
      "method": "GET",
      "path": "/mcp",
      "scopes": [
        "bot",
        "tx"
      ],
      "delegation": true
    },
    {
      "method": "OPTIONS",
      "path": "/mcp",
      "scopes": [
        "bot",
        "tx"
      ],
      "delegation": true
    },
    {
      "method": "PATCH",
      "path": "/mcp",
      "scopes": [
        "bot",
        "tx"
      ],
      "delegation": true
    },
    {
      "method": "POST",
      "path": "/mcp",
      "scopes": [
        "bot",
        "tx"
      ],
      "delegation": true
    },
    {
      "method": "PUT",
      "path": "/mcp",
      "scopes": [
        "bot",
        "tx"
      ],
      "delegation": true
    },
    {
      "method": "DELETE",
      "path": "/mcp/{path:path}",
      "scopes": [
        "bot",
        "tx"
      ],
      "delegation": true
    },
    {
      "method": "GET",
      "path": "/mcp/{path:path}",
      "scopes": [
        "bot",
        "tx"
      ],
      "delegation": true
    },
    {
      "method": "OPTIONS",
      "path": "/mcp/{path:path}",
      "scopes": [
        "bot",
        "tx"
      ],
      "delegation": true
    },
    {
      "method": "PATCH",
      "path": "/mcp/{path:path}",
      "scopes": [
        "bot",
        "tx"
      ],
      "delegation": true
    },
    {
      "method": "POST",
      "path": "/mcp/{path:path}",
      "scopes": [
        "bot",
        "tx"
      ],
      "delegation": true
    },
    {
      "method": "PUT",
      "path": "/mcp/{path:path}",
      "scopes": [
        "bot",
        "tx"
      ],
      "delegation": true
    }
  ]
}
