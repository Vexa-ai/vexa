{
  "manifest": {
    "contract": "mcp.tools.v1",
    "domain": "crm",
    "source": "oss",
    "owner": "core/crm",
    "base_url_env": "CRM_API_URL",
    "served_at": "/.well-known/mcp-tools.json",
    "depends_on": [
      "identity"
    ],
    "tools": [
      {
        "name": "crm_describe",
        "identity": "user",
        "auth": "subject",
        "requires": [
          "identity",
          "crm"
        ],
        "route": {
          "method": "POST",
          "path": "/describe"
        },
        "arguments": [
          "tenant_id",
          "object_type"
        ]
      },
      {
        "name": "crm_search",
        "identity": "user",
        "auth": "subject",
        "requires": [
          "identity",
          "crm"
        ],
        "route": {
          "method": "POST",
          "path": "/search"
        },
        "arguments": [
          "tenant_id",
          "object_type",
          "filters",
          "limit",
          "offset"
        ]
      },
      {
        "name": "crm_read",
        "identity": "user",
        "auth": "subject",
        "requires": [
          "identity",
          "crm"
        ],
        "route": {
          "method": "POST",
          "path": "/read"
        },
        "arguments": [
          "tenant_id",
          "record_id"
        ]
      },
      {
        "name": "crm_change",
        "identity": "user",
        "auth": "subject",
        "requires": [
          "identity",
          "crm"
        ],
        "route": {
          "method": "POST",
          "path": "/change"
        },
        "arguments": [
          "tenant_id",
          "action",
          "object_type",
          "record_id",
          "expected_revision",
          "fields",
          "narrative",
          "reason",
          "evidence",
          "idempotency_key"
        ]
      },
      {
        "name": "crm_history",
        "identity": "user",
        "auth": "subject",
        "requires": [
          "identity",
          "crm"
        ],
        "route": {
          "method": "POST",
          "path": "/history"
        },
        "arguments": [
          "tenant_id",
          "record_id"
        ]
      },
      {
        "name": "crm_review",
        "identity": "user",
        "auth": "subject",
        "requires": [
          "identity",
          "crm"
        ],
        "route": {
          "method": "POST",
          "path": "/review"
        },
        "arguments": [
          "tenant_id",
          "proposal_id",
          "accept"
        ]
      }
    ]
  },
  "openapi": {
    "openapi": "3.1.0",
    "info": {
      "title": "Vexa CRM",
      "version": "0.13.1"
    },
    "paths": {
      "/health": {
        "get": {
          "summary": "Health",
          "operationId": "health_health_get",
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {}
                }
              }
            }
          }
        }
      },
      "/.well-known/mcp-tools.json": {
        "get": {
          "summary": "Manifest",
          "operationId": "manifest__well_known_mcp_tools_json_get",
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {}
                }
              }
            }
          }
        }
      },
      "/describe": {
        "post": {
          "summary": "Describe",
          "description": "Discover CRM object types and readable fields for this tenant and caller. Use before filtering or writing unfamiliar fields.",
          "operationId": "crm_describe",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Describe"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {}
                }
              }
            },
            "422": {
              "description": "Validation Error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              }
            }
          }
        }
      },
      "/search": {
        "post": {
          "summary": "Search",
          "description": "Find authorized CRM records with equality filters and pagination. Results include stable IDs and revisions. Restricted fields cannot be used as filters.",
          "operationId": "crm_search",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Search"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {}
                }
              }
            },
            "422": {
              "description": "Validation Error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              }
            }
          }
        }
      },
      "/read": {
        "post": {
          "summary": "Read",
          "description": "Read permitted fields, source evidence, links, pending proposals and current revision. Top-level id is the native UUID for subsequent calls; fields.Id is the imported source ID. Use href for the native Minutes record link. Read before changing an existing record.",
          "operationId": "crm_read",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Read"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {}
                }
              }
            },
            "422": {
              "description": "Validation Error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              }
            }
          }
        }
      },
      "/change": {
        "post": {
          "summary": "Change",
          "description": "Create a record, update readable/writable fields, or submit a proposal. Updates require the revision returned by crm_read. Include a reason and source evidence; proposal does not mean saved. Permission and review policy are server-enforced.",
          "operationId": "crm_change",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Change"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {}
                }
              }
            },
            "422": {
              "description": "Validation Error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              }
            }
          }
        }
      },
      "/history": {
        "post": {
          "summary": "History",
          "description": "Read up to 100 recent record revisions. Current access permissions filter historical values too.",
          "operationId": "crm_history",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Read"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {}
                }
              }
            },
            "422": {
              "description": "Validation Error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              }
            }
          }
        }
      },
      "/review": {
        "post": {
          "summary": "Review",
          "description": "Accept or reject a pending proposal when the caller has review and record-write rights. Acceptance conflicts if the record changed since proposal creation.",
          "operationId": "crm_review",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Review"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {}
                }
              }
            },
            "422": {
              "description": "Validation Error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              }
            }
          }
        }
      }
    },
    "components": {
      "schemas": {
        "Change": {
          "properties": {
            "tenant_id": {
              "type": "string",
              "minLength": 1,
              "title": "Tenant Id",
              "description": "CRM tenant identifier. Membership is verified for the authenticated caller."
            },
            "action": {
              "type": "string",
              "enum": [
                "create",
                "update",
                "propose"
              ],
              "title": "Action"
            },
            "idempotency_key": {
              "type": "string",
              "maxLength": 200,
              "title": "Idempotency Key",
              "description": "Required for create: stable caller-generated key reused when retrying the same request.",
              "default": ""
            },
            "object_type": {
              "type": "string",
              "title": "Object Type",
              "default": ""
            },
            "record_id": {
              "type": "string",
              "title": "Record Id",
              "default": ""
            },
            "expected_revision": {
              "type": "integer",
              "minimum": 0.0,
              "title": "Expected Revision",
              "default": 0
            },
            "fields": {
              "additionalProperties": true,
              "type": "object",
              "title": "Fields"
            },
            "narrative": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Narrative"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "title": "Reason"
            },
            "evidence": {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array",
              "title": "Evidence"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "tenant_id",
            "action",
            "reason"
          ],
          "title": "Change"
        },
        "Describe": {
          "properties": {
            "tenant_id": {
              "type": "string",
              "minLength": 1,
              "title": "Tenant Id",
              "description": "CRM tenant identifier. Membership is verified for the authenticated caller."
            },
            "object_type": {
              "type": "string",
              "title": "Object Type",
              "description": "Optional object type; omit to discover permitted object types.",
              "default": ""
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "tenant_id"
          ],
          "title": "Describe"
        },
        "HTTPValidationError": {
          "properties": {
            "detail": {
              "items": {
                "$ref": "#/components/schemas/ValidationError"
              },
              "type": "array",
              "title": "Detail"
            }
          },
          "type": "object",
          "title": "HTTPValidationError"
        },
        "Read": {
          "properties": {
            "tenant_id": {
              "type": "string",
              "minLength": 1,
              "title": "Tenant Id",
              "description": "CRM tenant identifier. Membership is verified for the authenticated caller."
            },
            "record_id": {
              "type": "string",
              "title": "Record Id"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "tenant_id",
            "record_id"
          ],
          "title": "Read"
        },
        "Review": {
          "properties": {
            "tenant_id": {
              "type": "string",
              "minLength": 1,
              "title": "Tenant Id",
              "description": "CRM tenant identifier. Membership is verified for the authenticated caller."
            },
            "proposal_id": {
              "type": "string",
              "title": "Proposal Id"
            },
            "accept": {
              "type": "boolean",
              "title": "Accept"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "tenant_id",
            "proposal_id",
            "accept"
          ],
          "title": "Review"
        },
        "Search": {
          "properties": {
            "tenant_id": {
              "type": "string",
              "minLength": 1,
              "title": "Tenant Id",
              "description": "CRM tenant identifier. Membership is verified for the authenticated caller."
            },
            "object_type": {
              "type": "string",
              "title": "Object Type"
            },
            "filters": {
              "additionalProperties": true,
              "type": "object",
              "title": "Filters",
              "description": "Equality filters on readable fields; discover field names with crm_describe."
            },
            "limit": {
              "type": "integer",
              "maximum": 100.0,
              "minimum": 1.0,
              "title": "Limit",
              "default": 20
            },
            "offset": {
              "type": "integer",
              "minimum": 0.0,
              "title": "Offset",
              "default": 0
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "tenant_id",
            "object_type"
          ],
          "title": "Search"
        },
        "ValidationError": {
          "properties": {
            "loc": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "type": "array",
              "title": "Location"
            },
            "msg": {
              "type": "string",
              "title": "Message"
            },
            "type": {
              "type": "string",
              "title": "Error Type"
            },
            "input": {
              "title": "Input"
            },
            "ctx": {
              "type": "object",
              "title": "Context"
            }
          },
          "type": "object",
          "required": [
            "loc",
            "msg",
            "type"
          ],
          "title": "ValidationError"
        }
      }
    }
  }
}
