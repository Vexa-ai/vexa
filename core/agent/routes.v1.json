{
  "contract": "routes.v1",
  "domain": "agent",
  "owner": "core/agent",
  "edge": "gateway",
  "note": "The agent control plane. ABSENT in the no-agents profile (PRD decision 40.6) \u2014 these eight rows and the routes that carry them are simply not there, so a request 404s. The edge registers them from this file: `forward` maps /agent/<path> onto agent-api's /api/<path>, a literal row is a route of its own (`stream` relays server-sent events), and `delegation` admits a worker's own delegation token \u2014 on the friction report its harness files, and nowhere else.",
  "presence_env": "AGENT_API_URL",
  "forward": {
    "edge_prefix": "/agent/",
    "upstream_prefix": "/api/"
  },
  "routes": [
    {
      "method": "POST",
      "path": "/agent/chat",
      "scopes": [
        "bot",
        "tx"
      ],
      "stream": true
    },
    {
      "method": "POST",
      "path": "/agent/friction",
      "scopes": [
        "bot",
        "tx"
      ],
      "delegation": true
    },
    {
      "method": "GET",
      "path": "/agent/meeting/stream",
      "scopes": [
        "bot",
        "tx"
      ],
      "stream": true
    },
    {
      "method": "DELETE",
      "path": "/agent/{path:path}",
      "scopes": [
        "bot",
        "tx"
      ]
    },
    {
      "method": "GET",
      "path": "/agent/{path:path}",
      "scopes": [
        "bot",
        "tx"
      ]
    },
    {
      "method": "PATCH",
      "path": "/agent/{path:path}",
      "scopes": [
        "bot",
        "tx"
      ]
    },
    {
      "method": "POST",
      "path": "/agent/{path:path}",
      "scopes": [
        "bot",
        "tx"
      ]
    },
    {
      "method": "PUT",
      "path": "/agent/{path:path}",
      "scopes": [
        "bot",
        "tx"
      ]
    }
  ]
}
