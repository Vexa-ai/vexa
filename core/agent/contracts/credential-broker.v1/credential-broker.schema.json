{
  "$id": "https://vexa.ai/contracts/credential-broker.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "credential-broker.v1",
  "description": "The Connections credential broker's wire: the signed caller assertion every request carries, and the request and response bodies of each route. Callers are agent-api (role agent, and role git for the Git credential store) and the terminal's server routes (role human). The broker never returns a stored credential to the agent or human roles; only the git role reads a value back, for Git operations agent-api performs itself.",
  "x-routes": [
    {
      "method": "GET",
      "path": "/health",
      "roles": [],
      "response": "Health"
    },
    {
      "method": "GET",
      "path": "/api/connections",
      "roles": [
        "agent",
        "human"
      ],
      "response": "ConnectionList"
    },
    {
      "method": "POST",
      "path": "/api/setup",
      "roles": [
        "agent",
        "human"
      ],
      "request": "SetupRequest",
      "response": "ConnectionState"
    },
    {
      "method": "POST",
      "path": "/api/connections/{cid}/request",
      "roles": [
        "agent",
        "human"
      ],
      "response": "ConnectionState"
    },
    {
      "method": "POST",
      "path": "/api/connections/{cid}/prepare",
      "roles": [
        "agent",
        "human"
      ],
      "request": "PrepareRequest",
      "response": "PrepareResponse"
    },
    {
      "method": "POST",
      "path": "/api/connections/{cid}/custom-secret",
      "roles": [
        "human"
      ],
      "request": "CustomSecretRequest",
      "response": "ConnectionState"
    },
    {
      "method": "POST",
      "path": "/api/connections/{cid}/oauth-application",
      "roles": [
        "human"
      ],
      "request": "OAuthApplicationRequest",
      "response": "ConnectionState"
    },
    {
      "method": "POST",
      "path": "/api/connections/{cid}/authorize",
      "roles": [
        "human"
      ],
      "response": "AuthorizeResponse"
    },
    {
      "method": "GET",
      "path": "/api/auth/callback/google",
      "roles": [
        "human"
      ],
      "response": "CallbackResponse"
    },
    {
      "method": "POST",
      "path": "/api/connections/{cid}/disconnect",
      "roles": [
        "human"
      ],
      "response": "ConnectionState"
    },
    {
      "method": "POST",
      "path": "/api/connections/{cid}/delete",
      "roles": [
        "human"
      ],
      "response": "ConnectionState"
    },
    {
      "method": "POST",
      "path": "/api/connections/{cid}/read",
      "roles": [
        "agent",
        "human"
      ],
      "request": "AccountReadRequest",
      "response": "AccountReadResponse"
    },
    {
      "method": "POST",
      "path": "/api/connections/{cid}/draft",
      "roles": [
        "agent",
        "human"
      ],
      "request": "GmailDraftRequest",
      "response": "GmailDraftResponse"
    },
    {
      "method": "POST",
      "path": "/api/connections/{cid}/call",
      "roles": [
        "agent",
        "human"
      ],
      "request": "CustomCallRequest",
      "response": "CustomCallResponse"
    },
    {
      "method": "POST",
      "path": "/api/internal/git-secret",
      "roles": [
        "git"
      ],
      "request": "GitSecretRequest",
      "response": "GitSecretResponse"
    }
  ],
  "$defs": {
    "Role": {
      "enum": [
        "agent",
        "human",
        "git"
      ],
      "description": "agent: agent-api acting for the authenticated subject — may request, prepare, list and USE connections, never consent or store a credential. human: the terminal's server routes for a signed-in person — may also consent, store, disconnect and delete. git: agent-api's Git credential store — may only read and write Git credentials named for the asserted actor."
    },
    "Assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "actor",
        "session",
        "at",
        "nonce",
        "method",
        "path",
        "body"
      ],
      "description": "The claims carried in the X-Vexa-Assertion header as base64url(JSON), unpadded, followed by '.' and the hex HMAC-SHA256 of that encoded part under the role's key. Accepted from 30 seconds before to 5 seconds after the broker's clock, once (nonce), and only for the exact method, path with query, and body bytes it names.",
      "properties": {
        "role": {
          "$ref": "#/$defs/Role"
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "The subject the request acts for. Connections are owned by, and filtered on, this value."
        },
        "session": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "human: a keyed digest of the browser's sign-in cookie, which binds an OAuth callback to the session that started it. agent and git: a per-request correlation id."
        },
        "at": {
          "type": "integer",
          "description": "Unix seconds when the assertion was signed."
        },
        "nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Single-use; the broker refuses a second request carrying it."
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/api/",
          "maxLength": 16384,
          "description": "The exact request path, plus '?' and the raw query when there is one."
        },
        "body": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of the exact request body bytes, hex (the empty body hashes to e3b0c442…)."
        }
      }
    },
    "SignedAssertionVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "claims",
        "encoded",
        "signature",
        "header",
        "request_body"
      ],
      "description": "A deterministic interop vector: both language bindings must produce exactly `encoded`, `signature` and `header` from `key` and `claims`, and must verify `header` for the bound request. The key is a published test value, never a deployment key.",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 32
        },
        "claims": {
          "$ref": "#/$defs/Assertion"
        },
        "request_body": {
          "type": "string",
          "description": "The exact body bytes, as UTF-8 text, whose SHA-256 is claims.body."
        },
        "encoded": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "header": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.[a-f0-9]{64}$"
        }
      }
    },
    "ConnectionId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "Provider": {
      "enum": [
        "custom_secret",
        "google_calendar",
        "google_email"
      ],
      "description": "google_email and google_calendar use Google OAuth with fixed scopes. custom_secret stores any secret and, optionally, uses it at one human-approved HTTPS endpoint."
    },
    "ConnectionStatus": {
      "enum": [
        "awaiting_user",
        "ready",
        "disconnected",
        "deleted"
      ]
    },
    "ConnectionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_id",
        "status"
      ],
      "properties": {
        "connection_id": {
          "$ref": "#/$defs/ConnectionId"
        },
        "status": {
          "$ref": "#/$defs/ConnectionStatus"
        }
      }
    },
    "SetupRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "InputField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "label"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "location": {
          "enum": [
            "query",
            "body"
          ]
        }
      }
    },
    "OAuthSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_url",
        "token_url",
        "scopes"
      ],
      "properties": {
        "authorization_url": {
          "type": "string",
          "maxLength": 2000
        },
        "token_url": {
          "type": "string",
          "maxLength": 2000
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "token_auth": {
          "enum": [
            "client_secret_post",
            "client_secret_basic"
          ]
        }
      }
    },
    "SetupSpec": {
      "type": "object",
      "additionalProperties": false,
      "description": "A declarative setup a caller proposes. It takes effect only when a human saves the credential for it; the destination host is shown to that human and must be confirmed on first save.",
      "properties": {
        "oauth": {
          "oneOf": [
            {
              "$ref": "#/$defs/OAuthSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "documentation_url": {
          "type": "string",
          "maxLength": 2000
        },
        "endpoint": {
          "type": "string",
          "maxLength": 2000
        },
        "header": {
          "type": "string",
          "maxLength": 64
        },
        "scheme": {
          "enum": [
            "bearer",
            "raw",
            "telegram"
          ]
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ]
        },
        "secret_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "fields": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/InputField"
          }
        }
      }
    },
    "ConnectionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "label",
        "status",
        "created",
        "setup_request",
        "account",
        "setup",
        "application_configured",
        "approved_host"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ConnectionId"
        },
        "provider": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ConnectionStatus"
        },
        "created": {
          "type": "number"
        },
        "setup_request": {
          "type": "string",
          "description": "Changes whenever a caller asks for this connection's setup again; the panel opens on a change."
        },
        "account": {
          "type": "string",
          "description": "The provider account address when the provider reports one (Gmail)."
        },
        "setup": {
          "type": "object",
          "description": "The prepared SetupSpec, or {} when none was prepared."
        },
        "application_configured": {
          "type": "boolean"
        },
        "approved_host": {
          "type": "string",
          "description": "The destination host a human last approved for this connection's credential; a prepared setup naming any other host must be confirmed again (M3)."
        }
      }
    },
    "ConnectionList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connections"
      ],
      "properties": {
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConnectionRow"
          }
        }
      }
    },
    "PrepareRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setup"
      ],
      "properties": {
        "setup": {
          "$ref": "#/$defs/SetupSpec"
        }
      }
    },
    "PrepareResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_id",
        "status",
        "setup"
      ],
      "properties": {
        "connection_id": {
          "$ref": "#/$defs/ConnectionId"
        },
        "status": {
          "$ref": "#/$defs/ConnectionStatus"
        },
        "setup": {
          "$ref": "#/$defs/SetupSpec"
        }
      }
    },
    "CustomSecretRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "setup_request": {
          "type": "string",
          "maxLength": 80,
          "description": "The setup_request the human reviewed; a stale value is refused so a re-prepared setup cannot ride an older approval."
        },
        "confirmed_host": {
          "type": "string",
          "maxLength": 253,
          "description": "Required on the first save of a prepared setup: the destination host the human typed to confirm where the secret will be sent."
        },
        "fields": {
          "type": "object",
          "maxProperties": 10,
          "additionalProperties": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "value": {
          "type": "string",
          "maxLength": 65536
        },
        "endpoint": {
          "type": "string",
          "maxLength": 2000
        },
        "header": {
          "type": "string",
          "maxLength": 64
        },
        "scheme": {
          "enum": [
            "bearer",
            "raw"
          ]
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ]
        }
      }
    },
    "OAuthApplicationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_id",
        "client_secret",
        "setup_request"
      ],
      "properties": {
        "client_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "client_secret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "setup_request": {
          "type": "string",
          "maxLength": 80
        },
        "confirmed_host": {
          "type": "string",
          "maxLength": 253,
          "description": "Required on the first save: the token-exchange host, which receives the client secret."
        }
      }
    },
    "AuthorizeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorize_url"
      ],
      "properties": {
        "authorize_url": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "CallbackResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_id",
        "status"
      ],
      "properties": {
        "connection_id": {
          "$ref": "#/$defs/ConnectionId"
        },
        "status": {
          "enum": [
            "connected",
            "refused"
          ]
        }
      }
    },
    "AccountReadRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "enum": [
            "gmail.search",
            "gmail.read",
            "gmail.thread",
            "calendar.events"
          ]
        },
        "query": {
          "type": "string",
          "maxLength": 500
        },
        "page_token": {
          "type": "string",
          "maxLength": 2048
        },
        "message_id": {
          "type": "string",
          "maxLength": 128
        },
        "time_min": {
          "type": "string",
          "maxLength": 40
        },
        "time_max": {
          "type": "string",
          "maxLength": 40
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "AccountReadResponse": {
      "type": "object",
      "required": [
        "operation_id",
        "source",
        "untrusted_content"
      ],
      "description": "Provider content projected to a fixed field set. untrusted_content is always true: mail and calendar text is third-party input to the agent.",
      "properties": {
        "operation_id": {
          "type": "string"
        },
        "source": {
          "enum": [
            "google_email",
            "google_calendar"
          ]
        },
        "untrusted_content": {
          "const": true
        },
        "messages": {
          "type": "array"
        },
        "message": {
          "type": "object"
        },
        "events": {
          "type": "array"
        },
        "thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "has_more": {
          "type": "boolean"
        },
        "next_page_token": {
          "type": "string"
        },
        "total_messages": {
          "type": "integer"
        }
      }
    },
    "GmailDraftRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "recipient",
        "subject",
        "body"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9-]{8,80}$",
          "description": "Idempotency key: a retry with the same id and identical content returns the first result."
        },
        "recipient": {
          "type": "string",
          "minLength": 3,
          "maxLength": 320
        },
        "subject": {
          "type": "string",
          "maxLength": 500
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        }
      }
    },
    "GmailDraftResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "draft_id",
            "status",
            "sent"
          ],
          "properties": {
            "draft_id": {
              "type": "string"
            },
            "message_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "const": "draft_created"
            },
            "sent": {
              "const": false
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "ui_action",
            "instruction"
          ],
          "properties": {
            "status": {
              "const": "permission_required"
            },
            "ui_action": {
              "const": "open_connections"
            },
            "instruction": {
              "type": "string"
            }
          }
        }
      ]
    },
    "CustomCallRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parameters": {
          "type": "object",
          "maxProperties": 30,
          "additionalProperties": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "body": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "CustomCallResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "http_status",
        "content",
        "untrusted_content"
      ],
      "properties": {
        "operation_id": {
          "type": "string"
        },
        "http_status": {
          "type": "integer"
        },
        "content": {},
        "untrusted_content": {
          "const": true
        }
      }
    },
    "GitSecretRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "action"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^(pat/[A-Za-z0-9_.-]{1,128}|deploy/(user|ws)-[A-Za-z0-9_.-]{1,120}\\.(priv|pub))$"
        },
        "action": {
          "enum": [
            "get",
            "put",
            "migrate"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32768
        }
      }
    },
    "GitSecretResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "found",
        "value"
      ],
      "properties": {
        "found": {
          "type": "boolean"
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detail"
      ],
      "description": "Every refusal. detail is a fixed sentence; it never echoes input, a credential or a provider response body.",
      "properties": {
        "detail": {
          "type": "string"
        }
      }
    },
    "Health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "service",
        "store"
      ],
      "properties": {
        "status": {
          "const": "ok"
        },
        "service": {
          "const": "credential-broker"
        },
        "store": {
          "enum": [
            "local",
            "openbao"
          ],
          "description": "Which credential store backend this broker writes to."
        }
      }
    }
  }
}
