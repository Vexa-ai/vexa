{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vexa.ai/schemas/desktop.v1",
  "title": "desktop.v1",
  "description": "The desktop as a read model (desktop D1). DesktopSections is what agent-api's POST /api/desktop/sections answers for the person's own app: every workspace they can open (hidden ones only counted) and what each placed agent and file ref is now. Desktop is what the terminal's GET /api/desktop composes per request from crm-api's desk (placements, layout, proposals) and DesktopSections. Nothing in either is stored; no model is called. Cards (desktop D2, feature desktop_cards): crm-api's desk read carries cards, card_proposals and card_invites only while the feature is on; the composition then draws the Cards section, carries the pending rows and says so in cards_on.",
  "x-limits": {
    "refs": 100,
    "members": 50,
    "activityScan": 12,
    "fileChangeScan": 30,
    "faceBlocks": 8
  },
  "$defs": {
    "DesktopSectionsRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refs": {
          "type": "array",
          "maxItems": 100,
          "items": {"type": "string", "maxLength": 600},
          "description": "`agent:<routine id>`, `chat:<chat session id>` and `file:<workspace slug>/<path>` refs placed on the desktop. Any other kind (`workspace:`, `card:`) is not resolved here."
        }
      }
    },
    "DesktopSections": {
      "type": "object",
      "required": ["presence_visibility", "workspaces", "hidden_workspaces", "agents", "files"],
      "additionalProperties": false,
      "properties": {
        "presence_visibility": {"$ref": "#/$defs/PresenceVisibility"},
        "workspaces": {"type": "array", "items": {"$ref": "#/$defs/WorkspaceTile"}},
        "hidden_workspaces": {"type": "integer", "minimum": 0, "description": "How many workspaces the person hid. They are counted, never listed."},
        "agents": {"type": "array", "items": {"anyOf": [{"$ref": "#/$defs/AgentTile"}, {"$ref": "#/$defs/Unavailable"}, {"$ref": "#/$defs/Missing"}]}},
        "files": {"type": "array", "items": {"anyOf": [{"$ref": "#/$defs/FileTile"}, {"$ref": "#/$defs/Missing"}]}},
        "chats": {"type": "array", "items": {"anyOf": [{"$ref": "#/$defs/ChatTile"}, {"$ref": "#/$defs/Missing"}]}, "description": "The placed `chat:` refs, present only when some were asked for. The client draws them in Agents."}
      }
    },
    "PresenceVisibility": {
      "enum": ["off", "shared_chats", "workspace_members"],
      "description": "`_global/POLICIES.md` presence_visibility as applied: off = no presence at all; shared_chats = from chats the viewer shares with the person; workspace_members = a member is active in a workspace when a chat of theirs working there was active. A value nobody can read is applied as off."
    },
    "Presence": {
      "enum": ["now", "today", null],
      "description": "Coarse: now = within 10 minutes, today = within 24 hours. Never the viewer's own, never for a person who switched theirs off."
    },
    "Member": {
      "type": "object",
      "required": ["subject", "name", "initials", "role", "presence"],
      "additionalProperties": false,
      "properties": {
        "subject": {"type": "string"},
        "name": {"type": "string", "description": "What the person is called; their id when nobody wrote a name down."},
        "initials": {"type": "string", "maxLength": 3},
        "role": {"enum": ["owner", "contributor", "reader"]},
        "presence": {"$ref": "#/$defs/Presence"}
      }
    },
    "Activity": {
      "type": ["object", "null"],
      "required": ["line", "at"],
      "additionalProperties": false,
      "properties": {
        "line": {"type": "string", "description": "Who changed what, by name and by title: \"Valeriia changed Pricing notes\"."},
        "at": {"type": ["integer", "null"], "description": "Unix seconds."}
      }
    },
    "CallPlatform": {
      "enum": ["google_meet", "teams", "zoom", "jitsi", "vexa_call"],
      "description": "What kind of meeting the call is, by meeting-api's platform names: a bot meeting on Google Meet, Teams, Zoom or Jitsi, or an in-app Vexa call. The client draws it as an icon, never as words in the line."
    },
    "LastCall": {
      "type": ["object", "null"],
      "required": ["meeting", "line", "at"],
      "additionalProperties": false,
      "description": "The newest ended meeting that belongs to the workspace — its note page lives there, its chat works there, or it is bound there — of any kind, among the meetings the viewer may read.",
      "properties": {
        "meeting": {"type": "string", "description": "The call's meeting row id."},
        "platform": {"$ref": "#/$defs/CallPlatform"},
        "line": {"type": "string", "description": "The meeting's display name and the day: \"Weekly sync · Oct 14\". Never an id."},
        "at": {"type": "integer", "description": "When it ended, Unix seconds."}
      }
    },
    "LiveCall": {
      "type": ["object", "null"],
      "required": ["meeting", "since"],
      "additionalProperties": false,
      "description": "A meeting happening now that belongs to the workspace: a bot meeting whose bot is in the room, or a Vexa call whose room is open. The newest wins.",
      "properties": {
        "session": {"type": "string", "description": "A Vexa call's chat (what Join opens). Absent for a bot meeting: Join opens the meeting."},
        "meeting": {"type": "string"},
        "platform": {"$ref": "#/$defs/CallPlatform"},
        "line": {"type": "string", "description": "The meeting's display name. Never an id."},
        "people": {"type": "integer", "minimum": 0, "description": "People in the room, when known."},
        "since": {"type": "integer"}
      }
    },
    "WorkspaceTile": {
      "type": "object",
      "required": ["slug", "id", "name", "kind", "access", "write", "members", "last_activity", "last_call", "live_call"],
      "additionalProperties": false,
      "properties": {
        "slug": {"type": "string", "description": "`personal` for the person's own desk, `_global` for the company layer, else the workspace's slug."},
        "id": {"type": "string", "description": "The id a `file:` ref names it by: the person's subject id for their own desk, else the slug."},
        "name": {"type": "string", "description": "The name the person sees (Personal, Company, the workspace's name) — never a slug the person did not choose."},
        "kind": {"enum": ["private", "shared", "company"]},
        "access": {"enum": ["owner", "contributor", "reader"]},
        "write": {"type": "boolean", "description": "Opening it is write mode; false says it is read-only."},
        "members": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/Member"}, "description": "A private workspace's members are only the person. A shared one's roster is listed to its contributors and owners; a reader sees none. The company layer lists none."},
        "last_activity": {"$ref": "#/$defs/Activity"},
        "last_call": {"$ref": "#/$defs/LastCall"},
        "live_call": {"$ref": "#/$defs/LiveCall"}
      }
    },
    "AgentTile": {
      "type": "object",
      "required": ["ref", "id", "name", "what", "status", "last", "last_at", "next", "next_at", "where", "thread", "missing"],
      "additionalProperties": false,
      "properties": {
        "ref": {"type": "string", "pattern": "^agent:"},
        "id": {"type": "string"},
        "name": {"type": "string"},
        "what": {"type": ["string", "null"], "maxLength": 200, "description": "What it does, in the words it was made with (first line)."},
        "status": {"enum": ["running", "idle", "paused", "failed"], "description": "From flows' own state: paused when the flow is not active, else from its last run."},
        "last": {"type": ["string", "null"], "description": "How the last run ended: Ran · Running · Failed: <reason> · Refused: <reason>."},
        "last_at": {"type": ["integer", "null"]},
        "next": {"type": ["string", "null"], "description": "The schedule in words; null while paused."},
        "next_at": {"type": ["number", "null"]},
        "where": {"type": ["string", "null"], "description": "The name of the workspace its chat works in."},
        "thread": {"type": ["string", "null"], "description": "Its chat (what clicking the tile opens)."},
        "missing": {"const": false}
      }
    },
    "ChatTile": {
      "type": "object",
      "required": ["ref", "id", "title", "last", "last_at", "where", "missing"],
      "additionalProperties": false,
      "description": "One of the person's OWN chats. Another person's chat, or one that does not exist, is Missing.",
      "properties": {
        "ref": {"type": "string", "pattern": "^chat:"},
        "id": {"type": "string", "description": "The chat's session id (what clicking the tile opens)."},
        "title": {"type": "string", "description": "Its name; \"Untitled chat\" when nobody named it — never its id."},
        "last": {"type": ["string", "null"], "description": "When it was last active, in words: \"Active Oct 14\"."},
        "last_at": {"type": ["integer", "null"]},
        "where": {"type": ["string", "null"], "description": "The name of the workspace it works in."},
        "missing": {"const": false}
      }
    },
    "FileTile": {
      "type": "object",
      "required": ["ref", "slug", "path", "title", "where", "changed", "changed_at", "missing"],
      "additionalProperties": false,
      "properties": {
        "ref": {"type": "string", "pattern": "^file:"},
        "slug": {"type": "string"},
        "path": {"type": "string"},
        "title": {"type": "string", "description": "Its front-matter title, else its first heading, else its file name read aloud."},
        "where": {"type": ["string", "null"], "description": "The workspace's name."},
        "changed": {"type": ["string", "null"], "description": "Who changed it last: \"Valeriia changed it\"."},
        "changed_at": {"type": ["integer", "null"]},
        "missing": {"const": false}
      }
    },
    "Missing": {
      "type": "object",
      "required": ["ref", "missing"],
      "additionalProperties": false,
      "properties": {
        "ref": {"type": "string"},
        "missing": {"const": true}
      },
      "description": "A ref that is not the person's own, is gone, or that this viewer cannot open. It says nothing else."
    },
    "Unavailable": {
      "type": "object",
      "required": ["ref", "id", "missing", "unavailable"],
      "additionalProperties": false,
      "properties": {
        "ref": {"type": "string", "pattern": "^agent:"},
        "id": {"type": "string"},
        "missing": {"const": false},
        "unavailable": {"const": true}
      },
      "description": "Flows did not answer: the tile is drawn without status rather than guessed."
    },
    "SectionId": {
      "type": "string",
      "pattern": "^(workspaces|agents|files|cards|group:[a-z0-9-]{1,40})$"
    },
    "Section": {
      "type": "object",
      "required": ["id", "title", "hidden", "collapsed", "column", "span", "size", "items"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/SectionId"},
        "title": {"type": "string"},
        "hidden": {"type": "boolean"},
        "collapsed": {"type": "boolean"},
        "column": {"type": "integer", "minimum": 1, "maximum": 3},
        "span": {"type": "integer", "minimum": 1, "maximum": 3},
        "size": {"enum": ["compact", "normal", "tall"]},
        "items": {
          "type": "array",
          "items": {"anyOf": [{"$ref": "#/$defs/WorkspaceTile"}, {"$ref": "#/$defs/AgentTile"}, {"$ref": "#/$defs/ChatTile"}, {"$ref": "#/$defs/FileTile"}, {"$ref": "#/$defs/Unavailable"}, {"$ref": "#/$defs/Missing"}, {"$ref": "#/$defs/CardItem"}]}
        }
      }
    },
    "Proposal": {
      "type": "object",
      "required": ["id", "ops", "reason", "author", "created_at", "summary"],
      "properties": {
        "id": {"type": "string"},
        "ops": {"type": "array", "items": {"type": "object"}},
        "reason": {"type": "string"},
        "author": {"type": "string"},
        "created_at": {"type": "string"},
        "summary": {"type": "string"}
      }
    },
    "CardAbout": {
      "type": ["object", "null"],
      "required": ["kind", "ref"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["page", "chat", "workspace", "meeting", "crm"]},
        "ref": {"type": "string", "maxLength": 600}
      },
      "description": "What the card is about: page:<ws>/<path> · chat:<id> · workspace:<slug> · meeting:<id> · crm:<record id>. Membership never grants this target."
    },
    "CardMovement": {
      "type": ["object", "null"],
      "required": ["by", "kind", "what", "at"],
      "additionalProperties": false,
      "properties": {
        "by": {"type": "string"},
        "kind": {"enum": ["person", "agent"]},
        "what": {"type": "string", "maxLength": 160},
        "at": {"type": ["string", "integer"]}
      }
    },
    "CardMember": {
      "type": "object",
      "required": ["subject", "status"],
      "properties": {
        "subject": {"type": "string"},
        "status": {"enum": ["invited", "member"]}
      }
    },
    "CardActivity": {
      "type": "object",
      "required": ["by", "kind", "what", "at"],
      "properties": {
        "by": {"type": "string"},
        "kind": {"type": "string"},
        "what": {"type": "string"},
        "at": {"type": ["string", "integer"]}
      }
    },
    "FaceBlock": {
      "description": "A resolved face block, per viewer (blocks.v1 face profile). Structural blocks carry only their type and draw from the CardView; data blocks arrive filled; a field the viewer cannot read arrives as locked. The client sanitizes again; an unknown type is dropped.",
      "anyOf": [
        {"type": "object", "required": ["type"], "additionalProperties": false, "properties": {"type": {"enum": ["stepper", "people", "movement", "waiting", "next", "subcards", "ref", "status"]}}},
        {"type": "object", "required": ["type", "value"], "additionalProperties": false, "properties": {"type": {"const": "metric"}, "label": {"type": "string", "maxLength": 40}, "value": {"type": "string", "maxLength": 160}}},
        {"type": "object", "required": ["type", "text"], "additionalProperties": false, "properties": {"type": {"const": "text"}, "label": {"type": "string", "maxLength": 40}, "text": {"type": "string", "maxLength": 160}}},
        {"type": "object", "required": ["type", "value"], "additionalProperties": false, "properties": {"type": {"const": "progress"}, "label": {"type": "string", "maxLength": 40}, "value": {"type": "number", "minimum": 0, "maximum": 1}}},
        {"type": "object", "required": ["type", "at"], "additionalProperties": false, "properties": {"type": {"const": "due"}, "label": {"type": "string", "maxLength": 40}, "at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}}},
        {"type": "object", "required": ["type", "items"], "additionalProperties": false, "properties": {"type": {"const": "checklist"}, "label": {"type": "string", "maxLength": 40}, "items": {"type": "array", "maxItems": 10, "items": {"type": "object", "required": ["text", "done"], "additionalProperties": false, "properties": {"text": {"type": "string", "maxLength": 160}, "done": {"type": "boolean"}}}}}},
        {"type": "object", "required": ["type", "rows"], "additionalProperties": false, "properties": {"type": {"const": "list"}, "label": {"type": "string", "maxLength": 40}, "rows": {"type": "array", "maxItems": 4, "items": {"type": "string", "maxLength": 160}}}},
        {"type": "object", "required": ["type", "label"], "additionalProperties": false, "properties": {"type": {"const": "locked"}, "label": {"type": "string", "maxLength": 40}}}
      ]
    },
    "CardView": {
      "type": "object",
      "description": "A card as crm-api answers it to this viewer (crm.v1 is the owner; mirrored here for the composition). `activity` only on /card/read.",
      "required": ["id", "ref", "type", "revision", "title", "about", "state", "states", "side_states", "next", "waiting", "summary", "due", "progress", "workspaces", "parent", "children", "members", "face", "movement", "stalled", "can", "href"],
      "properties": {
        "id": {"type": "string"},
        "ref": {"type": "string", "pattern": "^card:"},
        "type": {"type": "string"},
        "revision": {"type": "integer", "minimum": 0},
        "title": {"type": "string", "maxLength": 200},
        "about": {"$ref": "#/$defs/CardAbout"},
        "state": {"type": "string"},
        "states": {"type": "array", "items": {"type": "string"}},
        "side_states": {"type": "array", "items": {"type": "string"}},
        "next": {"type": ["string", "null"]},
        "waiting": {"type": ["string", "null"]},
        "summary": {"type": ["string", "null"]},
        "due": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "progress": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "workspaces": {"type": "array", "items": {"type": "string"}},
        "parent": {"type": ["object", "null"], "required": ["id", "title"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}}},
        "children": {"type": "object", "required": ["done", "total", "items"], "properties": {"done": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}, "items": {"type": "array", "items": {"type": "object", "required": ["id", "title", "state", "done"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "state": {"type": "string"}, "done": {"type": "boolean"}}}}}},
        "members": {"type": "array", "items": {"$ref": "#/$defs/CardMember"}},
        "face": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/FaceBlock"}},
        "movement": {"$ref": "#/$defs/CardMovement"},
        "stalled": {"type": "boolean"},
        "can": {"type": "object", "required": ["edit", "transition", "review", "members"], "properties": {"edit": {"type": "boolean"}, "transition": {"type": "boolean"}, "review": {"type": "boolean"}, "members": {"type": "boolean"}}},
        "href": {"type": "string"},
        "activity": {"type": "array", "items": {"$ref": "#/$defs/CardActivity"}}
      }
    },
    "CardItem": {
      "description": "A card tile in the Cards section: a CardView with kind card.",
      "allOf": [{"$ref": "#/$defs/CardView"}, {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "card"}}}]
    },
    "CardProposal": {
      "type": "object",
      "required": ["id", "kind", "title", "workspace", "fields", "reason", "author_kind", "at"],
      "description": "A pending card proposal for this person: an agent's (or a person's) create or change, accepted with Add (crm review accept) or dismissed with Not now (reject).",
      "properties": {
        "id": {"type": "string"},
        "kind": {"enum": ["create", "change"]},
        "card": {"type": ["object", "null"], "required": ["id", "title"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}}},
        "title": {"type": "string"},
        "workspace": {"type": ["string", "null"]},
        "fields": {"type": "object"},
        "reason": {"type": "string"},
        "author_kind": {"enum": ["agent", "person"]},
        "at": {"type": ["string", "integer"]},
        "preview": {"type": ["object", "null"]}
      }
    },
    "Desktop": {
      "type": "object",
      "required": ["version", "undo_version", "sections", "proposals", "filters", "saved"],
      "additionalProperties": false,
      "description": "What the terminal's GET /api/desktop answers: crm-api's desk (version, layout, placements, proposals) composed with DesktopSections. Section order is the array order.",
      "properties": {
        "version": {"type": "integer", "minimum": 0},
        "undo_version": {"type": ["integer", "null"]},
        "sections": {"type": "array", "items": {"$ref": "#/$defs/Section"}},
        "proposals": {"type": "array", "items": {"$ref": "#/$defs/Proposal"}},
        "filters": {"description": "The active filters. The composition answers a list of {section, where, until?}; an object form is accepted for back-compatibility.", "anyOf": [{"type": "object", "additionalProperties": {"type": "object"}}, {"type": "array", "items": {"type": "object", "required": ["section", "where"], "additionalProperties": false, "properties": {"section": {"type": "string"}, "where": {"type": "string"}, "until": {"type": ["string", "null"]}}}}]},
        "saved": {"type": "array", "items": {"type": "string"}},
        "presence_visibility": {"$ref": "#/$defs/PresenceVisibility"},
        "hidden_workspaces": {"type": "integer", "minimum": 0},
        "cards_on": {"type": "boolean", "description": "The desk read carried cards (desktop_cards on). False or absent: no Cards section is drawn and no card call is made."},
        "card_proposals": {"type": "array", "items": {"$ref": "#/$defs/CardProposal"}, "description": "Only while desktop_cards is on."},
        "card_invites": {"type": "array", "items": {"$ref": "#/$defs/CardView"}, "description": "Cards the person was added to and has not accepted (status invited). Only while desktop_cards is on."}
      }
    },
    "AttentionRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "POST /api/desktop/attention (feature home2, person only). `cards` are the crm desk's cards as the terminal read them; they never widen access. `workspace` asks for one workspace (the workspace page): its key alone, with the richer lists; one the viewer cannot open answers an empty `workspaces`.",
      "properties": {
        "cards": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/CardIn"}},
        "workspace": {"type": ["string", "null"], "maxLength": 200}
      }
    },
    "CardIn": {
      "type": "object",
      "required": ["id"],
      "description": "The CardView fields the attention rules read; other fields are ignored. A card waits on the viewer when the viewer is one of its members and its `waiting` names them (subject, email, the email's local part or display name, whole-word, case-insensitive).",
      "properties": {
        "id": {"type": "string", "maxLength": 200},
        "title": {"type": ["string", "null"], "maxLength": 300},
        "state": {"type": ["string", "null"], "maxLength": 300},
        "next": {"type": ["string", "null"], "maxLength": 300},
        "waiting": {"type": ["string", "null"], "maxLength": 300},
        "due": {"type": ["string", "null"], "maxLength": 40},
        "workspaces": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 200}},
        "members": {"type": "array", "maxItems": 200, "items": {"type": "object", "properties": {"subject": {"type": "string"}, "status": {"type": "string"}}}}
      }
    },
    "Act": {
      "type": "object",
      "required": ["label", "kind"],
      "additionalProperties": false,
      "description": "What a click does, as a pointer to the owner's route. accept-proposal: source desk → POST /api/proposals/resolve {id: proposal, status: ran}; source call → POST /api/sessions/{session}/proposals/{proposal}/accept (or /reject). open-session: open the chat `session` (mark `notification` read with POST /api/notifications/read). open-page / prepare: open `path` in workspace `slug`. open-meeting: open meeting `meeting`. retry-routine: flows-api POST /reactions/{reaction}/retry as the person. open-card: open card `card`.",
      "properties": {
        "label": {"enum": ["Accept", "Open", "Prepare", "Join", "Retry", "Review", "Use"]},
        "kind": {"enum": ["accept-proposal", "open-session", "open-page", "open-meeting", "prepare", "retry-routine", "open-card"]},
        "source": {"enum": ["desk", "call", "identity"]},
        "proposal": {"type": "string"},
        "session": {"type": "string"},
        "notification": {"type": "string"},
        "path": {"type": "string"},
        "slug": {"type": "string"},
        "meeting": {"type": "string"},
        "routine": {"type": "string"},
        "reaction": {"type": "string"},
        "card": {"type": "string"}
      }
    },
    "Need": {
      "type": "object",
      "required": ["id", "kind", "workspace", "text", "at", "act"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "description": "<kind>:<stable id>."},
        "kind": {"enum": ["proposal", "mention", "card", "upcoming", "failed"]},
        "workspace": {"type": "string", "description": "A key of `workspaces`: personal, a workspace slug, or _global."},
        "text": {"type": "string", "maxLength": 120},
        "at": {"type": "integer"},
        "act": {"$ref": "#/$defs/Act"}
      }
    },
    "Work": {
      "type": "object",
      "required": ["kind", "label", "state", "when", "at", "ref"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["routine", "call", "room"]},
        "label": {"type": "string"},
        "state": {"enum": ["running", "ok", "failed", "next", "paused", "live"]},
        "when": {"type": ["string", "null"]},
        "at": {"type": ["integer", "null"]},
        "ref": {"type": "string", "pattern": "^(agent|chat|meeting):"},
        "session": {"type": "string"},
        "meeting": {"type": "string"}
      }
    },
    "RunLine": {
      "type": "object",
      "required": ["at", "ok", "what"],
      "additionalProperties": false,
      "properties": {"at": {"type": ["integer", "null"]}, "ok": {"type": "boolean"}, "what": {"type": "string"}}
    },
    "AttentionWorkspace": {
      "type": "object",
      "required": ["needs", "working", "rooms_active", "live_call", "last"],
      "additionalProperties": false,
      "properties": {
        "needs": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/Need"}},
        "working": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/Work"}},
        "rooms_active": {"type": "integer", "minimum": 0, "description": "Shared chats working here with a message in the last 2 hours."},
        "live_call": {"$ref": "#/$defs/LiveCall"},
        "last": {"type": ["string", "null"], "description": "The calm line: the workspace's last change, as its tile says it."},
        "rooms": {"type": "array", "maxItems": 20, "description": "One-workspace mode only.", "items": {"type": "object", "required": ["session", "name", "members", "last_active"], "additionalProperties": false, "properties": {"session": {"type": "string"}, "name": {"type": "string"}, "members": {"type": "integer"}, "last_active": {"type": ["integer", "null"]}, "unread": {"type": "integer", "minimum": 0, "description": "What others wrote since the viewer last read the room (since they joined, when never)."}, "closed": {"type": "boolean", "description": "The room row says it is closed (R1 room settings); absent there, open."}}}},
        "chats": {"type": "array", "maxItems": 20, "description": "One-workspace mode only: the person's own private chats working here.", "items": {"type": "object", "required": ["session", "name", "last_active"], "additionalProperties": false, "properties": {"session": {"type": "string"}, "name": {"type": "string"}, "last_active": {"type": ["integer", "null"]}}}},
        "routines": {"type": "array", "description": "One-workspace mode only.", "items": {"type": "object", "required": ["ref", "name", "state", "when", "last_at", "next_at", "runs"], "additionalProperties": false, "properties": {"ref": {"type": "string", "pattern": "^agent:"}, "name": {"type": "string"}, "state": {"enum": ["running", "ok", "failed", "next", "paused"]}, "when": {"type": ["string", "null"]}, "last_at": {"type": ["integer", "null"]}, "next_at": {"type": ["integer", "null"]}, "session": {"type": ["string", "null"], "description": "the routine's own chat, opened from its row"}, "runs": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/RunLine"}}}}},
        "calls": {"type": "array", "maxItems": 10, "description": "One-workspace mode only.", "items": {"type": "object", "required": ["meeting", "name", "at", "state"], "additionalProperties": false, "properties": {"meeting": {"type": "string"}, "name": {"type": "string"}, "at": {"type": ["integer", "null"]}, "state": {"enum": ["live", "ended", "upcoming"]}}}}
      }
    },
    "Attention": {
      "type": "object",
      "required": ["generated_at", "needs", "workspaces"],
      "additionalProperties": false,
      "description": "What POST /api/desktop/attention answers: every need for this person ranked (failed routines and proposals, mentions, cards waiting on you, upcoming calls sooner first; ties newest first), and per workspace its needs, what is working, rooms active, the live call and the calm line. Keys are exactly the slugs /api/desktop/sections lists; a workspace the viewer cannot open is never a key and no item names it. Nothing stored, no model call.",
      "properties": {
        "generated_at": {"type": "integer"},
        "needs": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/Need"}},
        "workspaces": {"type": "object", "additionalProperties": {"$ref": "#/$defs/AttentionWorkspace"}}
      }
    },
    "RefsRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "POST /api/desktop/refs (feature home2, person only): typed references from a rich README, resolved for this viewer.",
      "properties": {
        "refs": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 600, "description": "<kind>:<id>, kind one of room chat call file person card routine workspace."}},
        "workspace": {"type": "string", "maxLength": 200, "description": "The page's workspace (personal = the person's own), for relative file refs."},
        "cards": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/CardIn"}}
      }
    },
    "RefInvisible": {
      "type": "object",
      "required": ["kind", "visible"],
      "additionalProperties": false,
      "description": "A ref the viewer may not see, one that does not exist, or a malformed one — indistinguishable on purpose. Nothing from inside it.",
      "properties": {"kind": {"enum": ["room", "chat", "call", "file", "person", "card", "routine", "workspace", "unknown"]}, "visible": {"const": false}}
    },
    "RefVisible": {
      "type": "object",
      "required": ["kind", "visible", "name"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["room", "chat", "call", "file", "person", "card", "routine", "workspace"]},
        "visible": {"const": true},
        "name": {"type": "string"},
        "slug": {"type": "string"},
        "members": {"type": "integer", "minimum": 0},
        "session": {"type": "string"},
        "closed": {"type": "boolean"},
        "unread": {"type": "integer", "minimum": 0},
        "sub": {"type": ["string", "null"]},
        "meeting": {"type": "string"},
        "state": {"type": "string"},
        "path": {"type": "string"},
        "initials": {"type": "string", "maxLength": 3},
        "runs": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/RunLine"}}
      }
    },
    "Refs": {
      "type": "object",
      "required": ["refs"],
      "additionalProperties": false,
      "properties": {"refs": {"type": "object", "additionalProperties": {"anyOf": [{"$ref": "#/$defs/RefVisible"}, {"$ref": "#/$defs/RefInvisible"}]}}}
    }
  }
}
