{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Vexa-ai/vexa/main/calm/controls/no-egress.requirement.json",
  "title": "Tenant data-egress control",
  "description": "An edge that carries tenant data to another system declares its egress posture, so a security review can gate it. Data that leaves for a system the tenant does not host must be approved.",
  "type": "object",
  "allOf": [{ "$ref": "https://calm.finos.org/release/1.2/meta/control-requirement.json" }],
  "properties": {
    "control-id": { "const": "vexa-no-egress" },
    "dataClass": { "type": "string", "enum": ["audio", "transcript", "pii", "metadata"] },
    "destination": { "type": "string", "enum": ["tenant-hosted", "external-saas"] },
    "egressApproved": { "type": "boolean", "description": "Must be true for any external-saas destination carrying tenant data." }
  },
  "required": ["control-id", "dataClass", "destination", "egressApproved"],
  "if": { "properties": { "destination": { "const": "external-saas" } }, "required": ["destination"] },
  "then": { "properties": { "egressApproved": { "const": true } } }
}
